# =================================================================
# MERCADO BONSAI - TEMPLATE DE VARIÁVEIS DE AMBIENTE DE PRODUÇÃO
# Copie este arquivo para '.env' na VPS e preencha os valores reais.
# =================================================================

# 1. Configuração de Credenciais do PostgreSQL (Container do Banco)
POSTGRES_DB=mercadobonsai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_super_segura_aqui

# 2. Connection String do .NET para o PostgreSQL no Docker Compose
# Observação: 'db' é o nome de rede do container do PostgreSQL definido no docker-compose.yml
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=mercadobonsai;Username=postgres;Password=sua_senha_super_segura_aqui

# 3. Gateway de Pagamento Asaas
Asaas__ApiKey=seu_token_asaas_producao_ou_sandbox
Asaas__ApiUrl=https://sandbox.asaas.com/api/v3
Asaas__UserAgent=MercadoBonsai/1.0 (suporte@mercadobonsai.com.br)
Asaas__WebhookSecret=seu_secret_webhook_asaas

# 4. Cálculo de Frete Melhor Envio
MelhorEnvio__Token=seu_token_melhor_envio_aqui
MelhorEnvio__ApiUrl=https://www.melhorenvio.com.br/api/v2/me/shipment/calculate
MelhorEnvio__UserAgent=suporte@mercadobonsai.com.br

# 5. Configuração de E-mail Institucional (SMTP)
Smtp__Server=smtp.mercadobonsai.com.br
Smtp__Port=587
Smtp__SenderEmail=comercial@mercadobonsai.com.br
Smtp__SenderName=Mercado Bonsai Comercial
Smtp__Username=comercial@mercadobonsai.com.br
Smtp__Password=sua_senha_smtp_aqui
Smtp__EnableSsl=true

# 6. Webhook E-vendas (Opcional)
Webhook__EvendasUrl=http://api.e-vendas.net.br/api/pedidos/
Webhook__EvendasToken=seu_token_evendas_aqui

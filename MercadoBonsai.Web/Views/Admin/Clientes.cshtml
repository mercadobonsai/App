@model IEnumerable<MercadoBonsai.Domain.Entities.Usuario>
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Clientes e Vendedores - Painel Admin";
    var busca = ViewData["Busca"] as string;
    var perfilFilter = ViewData["PerfilFilter"] as int?;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: #4A7C59;"><i class="icon-base ri ri-user-settings-line me-2"></i>Gestão de Clientes e Cultivadores</h3>
            <p class="text-muted mb-0">Gerencie usuários, perfis, dados fiscais, financeiros e logotipos dos viveiros</p>
        </div>
    </div>

    <!-- Barra de Filtros e Busca -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Clientes" class="row g-3 align-items-center">
                <div class="col-md-6 col-lg-7">
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="icon-base ri ri-search-line"></i></span>
                        <input type="text" name="busca" value="@busca" class="form-control" placeholder="Buscar por Nome, E-mail, Razão Social ou CPF/CNPJ..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select name="perfil" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(!perfilFilter.HasValue)">Todos os Perfis</option>
                        <option value="1" selected="@(perfilFilter == 1)">Comprador</option>
                        <option value="2" selected="@(perfilFilter == 2)">Vendedor</option>
                        <option value="3" selected="@(perfilFilter == 3)">Administrador</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">Filtrar</button>
                    @if (!string.IsNullOrEmpty(busca) || perfilFilter.HasValue)
                    {
                        <a asp-action="Clientes" class="btn btn-outline-secondary" title="Limpar Filtros">
                            <i class="icon-base ri ri-close-line"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabela Materio de Clientes -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cliente / Viveiro</th>
                            <th>Contato</th>
                            <th>CPF / CNPJ</th>
                            <th>Perfil</th>
                            <th>Cadastro</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar me-3">
                                                @if (!string.IsNullOrEmpty(u.LogotipoUrl))
                                                {
                                                    <img src="@u.LogotipoUrl" alt="@u.Nome" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <span class="avatar-initial rounded-circle bg-label-success text-success fw-bold">
                                                        @u.Nome.Substring(0, 1).ToUpper()
                                                    </span>
                                                }
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@u.Nome</h6>
                                                <small class="text-muted">@(string.IsNullOrEmpty(u.RazaoSocial) ? "Pessoa Física" : u.RazaoSocial)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div><i class="icon-base ri ri-mail-line me-1 text-muted"></i>@u.Email</div>
                                            <div class="text-muted"><i class="icon-base ri ri-phone-line me-1"></i>@(string.IsNullOrEmpty(u.Telefone) ? "Não informado" : u.Telefone)</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small font-monospace">@(string.IsNullOrEmpty(u.CpfCnpj) ? "-" : u.CpfCnpj)</span>
                                    </td>
                                    <td>
                                        @if (u.Perfil == PerfilUsuario.Administrador)
                                        {
                                            <span class="badge bg-danger">Administrador</span>
                                        }
                                        else if (u.Perfil == PerfilUsuario.Vendedor)
                                        {
                                            <span class="badge bg-warning text-dark">Vendedor</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">Comprador</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@u.DataCadastro.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Admin" asp-action="EditarCliente" asp-route-id="@u.Id" class="btn btn-sm btn-outline-success">
                                            <i class="icon-base ri ri-edit-box-line me-1"></i> Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="icon-base ri ri-user-search-line mb-2" style="font-size: 3rem;"></i>
                                    <h6>Nenhum cliente ou vendedor encontrado</h6>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

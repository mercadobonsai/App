@model MercadoBonsai.Web.Models.PerfilViewModel
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = $"Editar Cliente #{Model.Id} - Mercado Bonsai";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #4A7C59;"><i class="icon-base ri ri-edit-box-line me-2"></i>Editar Cliente / Vendedor</h3>
            <p class="text-muted mb-0">Gerencie os dados cadastrais, fiscais, financeiros e o logotipo do viveiro</p>
        </div>
        <a asp-action="Clientes" class="btn btn-outline-secondary">
            <i class="icon-base ri ri-arrow-left-line me-1"></i> Voltar à Listagem
        </a>
    </div>

    <form asp-action="EditarCliente" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <!-- Coluna Principal (Formulários) -->
            <div class="col-lg-8">

                <!-- Card 1: Dados Cadastrais & Perfil -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-user-line me-2"></i>Dados Cadastrais & Perfil</h6>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nome" class="form-label fw-semibold"></label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label fw-semibold"></label>
                                <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Perfil" class="form-label fw-semibold"></label>
                                <select asp-for="Perfil" class="form-select" asp-items="Html.GetEnumSelectList<PerfilUsuario>()"></select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Dados Fiscais -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-file-text-line me-2"></i>Dados Fiscais</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="RazaoSocial" class="form-label fw-semibold"></label>
                                <input asp-for="RazaoSocial" class="form-control" placeholder="Nome Fantasia / Razão Social" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CpfCnpj" class="form-label fw-semibold"></label>
                                <input asp-for="CpfCnpj" class="form-control" placeholder="CPF ou CNPJ" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="InscricaoEstadual" class="form-label fw-semibold"></label>
                                <input asp-for="InscricaoEstadual" class="form-control" placeholder="I.E. se houver" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Dados Financeiros (Repasses) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-bank-card-line me-2"></i>Dados Financeiros para Repasse</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ChavePix" class="form-label fw-semibold"></label>
                                <input asp-for="ChavePix" class="form-control" placeholder="E-mail, CPF/CNPJ ou Chave Aleatória" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Banco" class="form-label fw-semibold"></label>
                                <input asp-for="Banco" class="form-control" placeholder="Ex: Banco do Brasil (001)" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Agencia" class="form-label fw-semibold"></label>
                                <input asp-for="Agencia" class="form-control" placeholder="Ex: 1234-5" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Conta" class="form-label fw-semibold"></label>
                                <input asp-for="Conta" class="form-control" placeholder="Ex: 98765-4" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Apresentação do Viveiro -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-landscape-line me-2"></i>Apresentação do Viveiro</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="DescricaoViveiro" class="form-label fw-semibold"></label>
                            <textarea asp-for="DescricaoViveiro" class="form-control" rows="4" placeholder="Escreva uma breve apresentação do seu viveiro, espécies cultivadas, tempo de experiência e especialidades..."></textarea>
                            <small class="text-muted">Esta descrição poderá ser exibida no card de patrocinadores/destaque da Home.</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="icon-base ri ri-save-line me-1"></i> Salvar Alterações
                    </button>
                    <a asp-action="Clientes" class="btn btn-outline-secondary">Cancelar</a>
                </div>

            </div>

            <!-- Coluna Lateral (Logotipo & Log de Alteração) -->
            <div class="col-lg-4">
                
                <!-- Card: Logotipo do Viveiro -->
                <div class="card border-0 shadow-sm mb-4 text-center">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-image-edit-line me-2"></i>Logotipo do Viveiro</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.LogotipoUrl))
                            {
                                <img src="@Model.LogotipoUrl" alt="Logotipo do Viveiro" class="img-fluid rounded shadow-sm mb-3" style="max-height: 180px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="bg-light rounded p-4 mb-3 d-flex flex-column align-items-center justify-content-center">
                                    <i class="icon-base ri ri-store-3-line text-muted" style="font-size: 3rem;"></i>
                                    <span class="text-muted small mt-2">Sem logotipo cadastrado</span>
                                </div>
                            }
                        </div>
                        <div class="text-start">
                            <label asp-for="LogotipoArquivo" class="form-label fw-semibold"></label>
                            <input asp-for="LogotipoArquivo" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">Formatos: PNG, JPG, WEBP.</small>
                        </div>
                    </div>
                </div>

                <!-- Card: Log de Auditoria -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h6 class="fw-bold mb-0 text-dark"><i class="icon-base ri ri-history-line me-2"></i>Log de Auditoria</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="small">
                            <div class="mb-2">
                                <span class="text-muted">Última Alteração:</span><br />
                                <strong>@(Model.DataUltimaAlteracao.HasValue ? Model.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Nenhuma alteração recente")</strong>
                            </div>
                            <div>
                                <span class="text-muted">Alterado por:</span><br />
                                <strong>@(string.IsNullOrEmpty(Model.UsuarioAlteracaoNome) ? "Sistema" : Model.UsuarioAlteracaoNome)</strong>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/starter-kit/assets/js/masks.js"></script>
}

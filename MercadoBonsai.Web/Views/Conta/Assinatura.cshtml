@model IEnumerable<MercadoBonsai.Domain.Entities.Plano>
@{
    ViewData["Title"] = "Assinatura e Planos - Mercado Bonsai";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    var isAuthenticated = ViewData["IsAuthenticated"] as bool? ?? (User.Identity?.IsAuthenticated == true);
    var planoAtualId = ViewData["PlanoAtualId"] as int? ?? (isAuthenticated ? 1 : 0);
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="text-center mb-5">
        <span class="badge bg-label-success px-3 py-2 fs-6 fw-bold mb-2">⭐ Planos para Cultivadores e Vendedores</span>
        <h2 class="fw-bold mb-2" style="color: #4A7C59;">Escolha o Plano Ideal para o Seu Viveiro</h2>
        <p class="text-muted mb-3">Aumente seus limites de leilões, rifas, reduza taxas de comissão e destaque suas plantas na Home</p>
        
        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalTaxasFinanceiras">
            <i class="icon-base ri ri-information-line me-1 fs-5 align-middle"></i> Entenda as Taxas e Repasses
        </button>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Grid Layout 2 por Linha (col-lg-6) -->
    <div class="row g-4 justify-content-center">
        @foreach (var plano in Model)
        {
            var ePlanoAtual = isAuthenticated && (plano.Id == planoAtualId);
            <div class="col-lg-6 col-md-6 mb-4">
                <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden @(ePlanoAtual ? "border-2 border-success" : "")">
                    @if (ePlanoAtual)
                    {
                        <div class="bg-success text-white text-center py-1 fw-bold small">
                            PLANO ATUALMENTE ATIVO
                        </div>
                    }
                    <div class="card-body p-4 p-lg-5 d-flex flex-column justify-content-between text-center">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="fw-bold mb-0">Plano @plano.Nome</h4>
                                <button type="button" class="btn btn-link text-muted p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#modalTaxasFinanceiras" title="Saiba mais sobre taxas">
                                    <i class="icon-base ri ri-question-line fs-5"></i>
                                </button>
                            </div>

                            <div class="my-4">
                                @if (plano.Preco == 0)
                                {
                                    <h2 class="display-6 fw-bold text-success mb-0">Gratuito</h2>
                                    <small class="text-muted">Sem mensalidade fixa</small>
                                }
                                else
                                {
                                    <h2 class="display-6 fw-bold text-success mb-0">R$ @plano.Preco.ToString("N2", ptBr)</h2>
                                    <small class="text-muted">por mês</small>
                                }
                            </div>

                            <ul class="list-unstyled text-start my-4 gap-3 d-flex flex-column">
                                <li class="d-flex align-items-center">
                                    <i class="icon-base ri ri-checkbox-circle-fill text-success fs-5 me-2"></i>
                                    <span>Comissão reduzida por venda: <strong>@plano.PercentualComissao.ToString("N2", ptBr)%</strong></span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="icon-base ri ri-checkbox-circle-fill text-success fs-5 me-2"></i>
                                    <span>Até <strong>@plano.LimiteLeiloes30Dias leilões</strong> a cada 30 dias</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="icon-base ri ri-checkbox-circle-fill text-success fs-5 me-2"></i>
                                    <span>Até <strong>@plano.LimiteRifas30Dias rifas</strong> a cada 30 dias</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="icon-base ri ri-checkbox-circle-fill text-success fs-5 me-2"></i>
                                    <span>Limite de até <strong>@plano.LimiteAnuncios anúncios</strong> ativos</span>
                                </li>
                                <li class="d-flex align-items-center">
                                    @if (plano.DestaquesHome)
                                    {
                                        <i class="icon-base ri ri-checkbox-circle-fill text-success fs-5 me-2"></i>
                                        <span>Exibição na seção <strong>Destaques da Semana</strong> na Home</span>
                                    }
                                    else
                                    {
                                        <i class="icon-base ri ri-close-circle-line text-muted fs-5 me-2"></i>
                                        <span class="text-muted">Sem exibição em Destaques na Home</span>
                                    }
                                </li>
                            </ul>
                        </div>

                        <div class="mt-3">
                            @if (ePlanoAtual)
                            {
                                <button class="btn btn-outline-success w-100 disabled" disabled>Plano Ativo</button>
                            }
                            else if (isAuthenticated)
                            {
                                <form asp-action="TrocarPlano" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="planoId" value="@plano.Id" />
                                    <button type="submit" class="btn @(plano.Id >= 3 ? "btn-warning" : "btn-success") w-100 fw-bold shadow-sm">
                                        Assinar Plano @plano.Nome
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Conta" asp-action="Login" asp-route-returnUrl="/Planos" class="btn @(plano.Id >= 3 ? "btn-warning" : "btn-success") w-100 fw-bold shadow-sm">
                                    Assinar Plano @plano.Nome
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Informativo de Taxas Financeiras / Gateway (Asaas) -->
<div class="modal fade" id="modalTaxasFinanceiras" tabindex="-1" aria-labelledby="modalTaxasLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold text-white" id="modalTaxasLabel">
                    <i class="icon-base ri ri-shield-check-line me-2"></i> Transparência de Taxas e Processamento Financeiro
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-4 text-start">
                <p class="text-muted mb-4 fs-6">
                    No <strong>Mercado Bonsai</strong> prezamos pela transparência total com nossos viveiristas e cultivadores. Abaixo você encontra a divisão clara de como funcionam as retenções de vendas:
                </p>

                <div class="card border border-success bg-light mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-success mb-2">
                            <i class="icon-base ri ri-store-2-line me-1"></i> 1. Comissão da Plataforma (Mercado Bonsai)
                        </h6>
                        <p class="mb-0 small text-dark">
                            Destinada exclusivamente à manutenção técnica, suporte especializado, hospedagem e constante evolução da infraestrutura do marketplace. Corresponde à porcentagem vinculada ao seu plano contratado (ex: 10,00%, 7,00%, 4,00%).
                        </p>
                    </div>
                </div>

                <div class="card border border-info bg-light">
                    <div class="card-body">
                        <h6 class="fw-bold text-info mb-2">
                            <i class="icon-base ri ri-bank-card-line me-1"></i> 2. Taxas de Meios de Pagamento / Operacionais (Asaas)
                        </h6>
                        <p class="mb-2 small text-dark">
                            As transações bancárias e de recebimentos (Cartão de Crédito, Boleto Bancário ou PIX) são processadas de forma segura e automatizada pela instituição parceira <strong>Asaas IP S.A.</strong>.
                        </p>
                        <ul class="small mb-0 text-muted ps-3">
                            <li>Aplicam-se as tarifas operacionais padrão de liquidação de recebimentos da instituição bancária parceira.</li>
                            <li>O repasse dos valores líquidos é efetuado diretamente na subconta vinculada ao vendedor no Asaas.</li>
                            <li>O Mercado Bonsai <strong>não cobra taxas ocultas</strong> nem adiciona margens sobre as tarifas operacionais do gateway parceiro.</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

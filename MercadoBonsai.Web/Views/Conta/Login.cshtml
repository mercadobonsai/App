@model MercadoBonsai.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login - MercadoBonsai";
}

<!doctype html>
<html lang="pt-BR" class="layout-navbar-fixed" dir="ltr" data-skin="default"
      data-assets-path="~/starter-kit/assets/" data-template="horizontal-menu-template-no-customizer-starter"
      data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/starter-kit/assets/img/favicon/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/css/demo.css" />
    <script src="~/starter-kit/assets/vendor/js/helpers.js"></script>
    <script src="~/starter-kit/assets/js/config.js"></script>
    <style>
        .authentication-wrapper { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .authentication-inner { max-width: 460px; width: 100%; }
    </style>
</head>
<body>
    <div class="authentication-wrapper authentication-cover p-4">
        <div class="authentication-inner">
            <div class="card p-2">
                <div class="card-body">
                    <div class="app-brand justify-content-center mb-6">
                        <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2">
                            <span class="app-brand-logo demo">
                                <span class="text-primary">
                                    <svg width="30" height="24" viewBox="0 0 250 196" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.3002 1.25469L56.655 28.6432C59.0349 30.1128 60.4839 32.711 60.4839 35.5089V160.63C60.4839 163.468 58.9941 166.097 56.5603 167.553L12.2055 194.107C8.3836 196.395 3.43136 195.15 1.14435 191.327C0.395485 190.075 0 188.643 0 187.184V8.12039C0 3.66447 3.61061 0.0522461 8.06452 0.0522461C9.56056 0.0522461 11.0271 0.468577 12.3002 1.25469Z" fill="currentColor" />
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M237.71 1.22393L193.355 28.5207C190.97 29.9889 189.516 32.5905 189.516 35.3927V160.631C189.516 163.469 191.006 166.098 193.44 167.555L237.794 194.108C241.616 196.396 246.569 195.151 248.856 191.328C249.605 190.076 250 188.644 250 187.185V8.09597C250 3.64006 246.389 0.027832 241.935 0.027832C240.444 0.027832 238.981 0.441882 237.71 1.22393Z" fill="currentColor" />
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.2787 1.18923L125 70.3075V136.87L0 65.2465V8.06814C0 3.61223 3.61061 0 8.06452 0C9.552 0 11.0105 0.411583 12.2787 1.18923Z" fill="currentColor" />
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M237.721 1.18923L125 70.3075V136.87L250 65.2465V8.06814C250 3.61223 246.389 0 241.935 0C240.448 0 238.99 0.411583 237.721 1.18923Z" fill="currentColor" />
                                    </svg>
                                </span>
                            </span>
                            <span class="app-brand-text demo menu-text fw-semibold ms-1">MercadoBonsai</span>
                        </a>
                    </div>

                    <h4 class="mb-1">Bem-vindo de volta! 👋</h4>
                    <p class="mb-6">Faça login para acessar sua conta.</p>

                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success mb-4" role="alert">
                            <i class="ri ri-checkbox-circle-line me-2"></i>@TempData["Sucesso"]
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="seu@email.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Senha" class="form-label"></label>
                            <div class="input-group input-group-merge">
                                <input asp-for="Senha" id="senha-input" class="form-control" placeholder="••••••••" />
                                <span class="input-group-text cursor-pointer" onclick="toggleSenha()">
                                    <i id="senha-icon" class="icon-base ri ri-eye-off-line icon-sm"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <div class="mb-6 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMe" />
                                <label asp-for="LembrarMe" class="form-check-label">Lembrar-me</label>
                            </div>
                            <a href="#" class="text-body fw-medium">Esqueceu a senha?</a>
                        </div>

                        <button type="submit" class="btn btn-primary d-grid w-100 mb-4">Entrar</button>

                        <p class="text-center mb-0">
                            Ainda não tem conta?
                            <a asp-controller="Conta" asp-action="Cadastro" class="fw-medium">Cadastre-se</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/starter-kit/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/starter-kit/assets/vendor/js/bootstrap.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="~/starter-kit/assets/js/main.js"></script>
    <script>
        function toggleSenha() {
            const input = document.getElementById('senha-input');
            const icon = document.getElementById('senha-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('ri-eye-off-line', 'ri-eye-line');
            } else {
                input.type = 'password';
                icon.classList.replace('ri-eye-line', 'ri-eye-off-line');
            }
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>

@model MercadoBonsai.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login - Mercado Bonsai";
}

<!doctype html>
<html lang="pt-BR" class="layout-navbar-fixed" dir="ltr" data-skin="default"
      data-assets-path="~/starter-kit/assets/" data-template="horizontal-menu-template-no-customizer-starter"
      data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/starter-kit/assets/img/favicon/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/css/demo.css" />
    <script src="~/starter-kit/assets/vendor/js/helpers.js"></script>
    <script src="~/starter-kit/assets/js/config.js"></script>
    <style>
        .authentication-wrapper { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .authentication-inner { max-width: 460px; width: 100%; }
    </style>
</head>
<body>
    <div class="authentication-wrapper authentication-cover p-4">
        <div class="authentication-inner">
            <div class="card p-2">
                <div class="card-body">
                    <div class="app-brand justify-content-center mb-6">
                        <a asp-controller="Produto" asp-action="Index" class="app-brand-link gap-2 align-items-center">
                            <img src="~/starter-kit/assets/img/logo.png" alt="Mercado Bonsai Logo" style="height: 42px; width: auto; border-radius: 6px;" />
                            <span class="app-brand-text demo menu-text fw-bold ms-1" style="color: #4A7C59;">Mercado Bonsai</span>
                        </a>
                    </div>

                    <h4 class="mb-1">Bem-vindo de volta! 👋</h4>
                    <p class="mb-6">Faça login para acessar sua conta.</p>

                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success mb-4" role="alert">
                            <i class="ri ri-checkbox-circle-line me-2"></i>@TempData["Sucesso"]
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="seu@email.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Senha" class="form-label"></label>
                            <div class="input-group input-group-merge">
                                <input asp-for="Senha" id="senha-input" class="form-control" placeholder="••••••••" />
                                <span class="input-group-text cursor-pointer" onclick="toggleSenha()">
                                    <i id="senha-icon" class="icon-base ri ri-eye-off-line icon-sm"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <div class="mb-6 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMe" />
                                <label asp-for="LembrarMe" class="form-check-label">Lembrar-me</label>
                            </div>
                            <a href="#" class="text-body fw-medium">Esqueceu a senha?</a>
                        </div>

                        <button type="submit" class="btn btn-primary d-grid w-100 mb-4">Entrar</button>

                        <p class="text-center mb-0">
                            Ainda não tem conta?
                            <a asp-controller="Conta" asp-action="Cadastro" class="fw-medium">Cadastre-se</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/starter-kit/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/starter-kit/assets/vendor/js/bootstrap.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="~/starter-kit/assets/js/main.js"></script>
    <script>
        function toggleSenha() {
            const input = document.getElementById('senha-input');
            const icon = document.getElementById('senha-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('ri-eye-off-line', 'ri-eye-line');
            } else {
                input.type = 'password';
                icon.classList.replace('ri-eye-line', 'ri-eye-off-line');
            }
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>

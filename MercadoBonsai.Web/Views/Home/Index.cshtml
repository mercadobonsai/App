@model MercadoBonsai.Web.Models.HomeEngajamentoViewModel
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Página Inicial";
}

<div class="row">
    <!-- Coluna Principal (9 colunas em telas grandes, 12 em mobile) -->
    <div class="col-lg-9 col-12 mb-4">

        <!-- Hero Section -->
        <div class="card mb-5 border-0 overflow-hidden shadow-lg position-relative" style="background: linear-gradient(135deg, #1E3A2B 0%, #355E3B 50%, #4A7C59 100%); color: #ffffff; border-radius: 16px;">
            <div class="card-body p-4 p-md-5 my-md-2">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-white text-success px-3 py-2 fs-6 fw-bold mb-3 shadow-sm rounded-pill">
                            🌱 O Maior Portal de Bonsais do Brasil
                        </span>
                        <h1 class="display-5 fw-bold text-white mb-3" style="letter-spacing: -0.5px; line-height: 1.15;">
                            A Arte Viva do Cultivo em Suas Mãos
                        </h1>
                        <p class="fs-6 text-white-50 mb-4" style="max-width: 600px;">
                            Conectamos cultivadores apaixonados, mestres da arte bonsai e entusiastas em um marketplace exclusivo com frete especializado e plantas de qualidade superior.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Produto" asp-action="Index" class="btn btn-success btn-lg px-4 shadow">
                                <i class="icon-base ri ri-shopping-bag-3-line me-2"></i> Explorar Vitrine
                            </a>
                            @if (User.IsInRole("Vendedor") || User.IsInRole("Administrador"))
                            {
                                <a asp-controller="Produto" asp-action="Criar" class="btn btn-outline-light btn-lg px-4">
                                    <i class="icon-base ri ri-add-circle-line me-2"></i> Anunciar Bonsai
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Conta" asp-action="Cadastro" class="btn btn-outline-light btn-lg px-4">
                                    <i class="icon-base ri ri-user-add-line me-2"></i> Criar Conta Vendedor
                                </a>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4 d-none d-lg-block text-center position-relative">
                        <div class="p-2">
                            <img src="~/starter-kit/assets/img/logo.png" alt="Mercado Bonsai" class="img-fluid rounded-4 shadow-lg bg-white p-3" style="max-height: 220px; object-fit: contain;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ESPAÇO DE PROPAGANDA AVANÇADO: Full Banner (1 por linha - col-12) -->
        @if (Model.PropagandasAvancado != null && Model.PropagandasAvancado.Any())
        {
            <div class="mb-5">
                @foreach (var ad in Model.PropagandasAvancado)
                {
                    <div class="card border-0 shadow-sm overflow-hidden mb-3">
                        <a href="@ad.LinkDestino" target="_blank" title="Anúncio Patrocinado">
                            <img src="@ad.ImagemUrl" class="w-100 rounded" style="max-height: 140px; object-fit: cover;" alt="Banner Patrocinado Avançado" />
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Destaques da Semana Section (Fotos com Proporção Padronizada 4/3 sem Cortes) -->
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1" style="color: #4A7C59;">🌿 Destaques da Semana</h4>
                    <p class="text-muted mb-0">Exemplares e bonsais recém-anunciados no portal</p>
                </div>
                <a asp-controller="Produto" asp-action="Index" class="btn btn-sm btn-outline-success">
                    Ver Todos <i class="icon-base ri ri-arrow-right-line ms-1"></i>
                </a>
            </div>

            @if (Model.ProdutosDestaque != null && Model.ProdutosDestaque.Any())
            {
                <div class="row g-4">
                    @foreach (var p in Model.ProdutosDestaque)
                    {
                        var isIndisponivel = p.Status == StatusProduto.Indisponivel;
                        <div class="col-sm-6 col-md-4">
                            <div class="card h-100 shadow-sm border-0 hover-top transition overflow-hidden" style="@(isIndisponivel ? "opacity: 0.65; filter: grayscale(30%);" : "")">
                                <div class="position-relative overflow-hidden bg-light" style="aspect-ratio: 4/3; width: 100%;">
                                    @if (!string.IsNullOrEmpty(p.ImagemUrl))
                                    {
                                        <img src="@p.ImagemUrl" class="card-img-top w-100 h-100" alt="@p.Nome" style="object-fit: cover; object-position: center;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center w-100 h-100 bg-light">
                                            <i class="icon-base ri ri-image-line text-muted" style="font-size: 2.5rem;"></i>
                                        </div>
                                    }
                                    @if (isIndisponivel)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 end-0 m-2 shadow-sm">Indisponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success position-absolute top-0 end-0 m-2 shadow-sm">Recente</span>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between p-3">
                                    <div>
                                        <h6 class="card-title fw-bold mb-1">@p.Nome</h6>
                                        <p class="card-text text-muted text-truncate-2 small mb-2">@(string.IsNullOrWhiteSpace(p.Descricao) ? "Bonsai selecionado de alta qualidade." : p.Descricao)</p>
                                    </div>
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fs-5 fw-bold @(isIndisponivel ? "text-muted" : "text-success")">R$ @p.Preco.ToString("N2")</span>
                                            <small class="text-muted"><i class="icon-base ri ri-stack-line me-1"></i>Estoque: @p.QuantidadeEstoque</small>
                                        </div>
                                        <a asp-controller="Produto" asp-action="Detalhes" asp-route-id="@p.Id" class="btn btn-sm @(isIndisponivel ? "btn-outline-secondary" : "btn-outline-success") w-100">
                                            <i class="icon-base ri ri-eye-line me-1"></i> Ver Detalhes
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card text-center p-4 border-0 shadow-sm">
                    <div class="card-body">
                        <i class="icon-base ri ri-leaf-line text-success mb-2" style="font-size: 3rem;"></i>
                        <h6 class="fw-bold">Nenhum bonsai cadastrado ainda</h6>
                        <p class="text-muted small">Seja o primeiro a publicar um anúncio no portal!</p>
                        <a asp-controller="Produto" asp-action="Criar" class="btn btn-sm btn-success mt-1 px-3">Cadastrar Anúncio</a>
                    </div>
                </div>
            }
        </div>

        <!-- Benefícios / Diferenciais Section -->
        <div class="row g-3 mb-5">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="avatar avatar-md mx-auto mb-2 bg-label-success rounded-circle">
                        <i class="icon-base ri ri-truck-line fs-3 text-success"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Frete Especializado</h6>
                    <p class="text-muted mb-0 small" style="font-size: 0.8rem;">Embalagens antichoque para manter plantas vivas seguras.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="avatar avatar-md mx-auto mb-2 bg-label-success rounded-circle">
                        <i class="icon-base ri ri-shield-check-line fs-3 text-success"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Cultivadores Certificados</h6>
                    <p class="text-muted mb-0 small" style="font-size: 0.8rem;">Garantia de procedência e espécies autenticadas.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="avatar avatar-md mx-auto mb-2 bg-label-success rounded-circle">
                        <i class="icon-base ri ri-book-read-line fs-3 text-success"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Suporte de Cultivo</h6>
                    <p class="text-muted mb-0 small" style="font-size: 0.8rem;">Dicas de rega, poda e adubação para cada exemplar.</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="avatar avatar-md mx-auto mb-2 bg-label-success rounded-circle">
                        <i class="icon-base ri ri-lock-2-line fs-3 text-success"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Compra Garantida</h6>
                    <p class="text-muted mb-0 small" style="font-size: 0.8rem;">Pagamento seguro intermediado com proteção total.</p>
                </div>
            </div>
        </div>

        <!-- Banner de Recrutamento de Vendedores -->
        <div class="card border-0 shadow-sm overflow-hidden mb-5" style="background-color: #F4F8F5;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="fw-bold mb-1" style="color: #1E3A2B;">Você é cultivador ou produtor de Bonsais?</h5>
                        <p class="text-muted small mb-md-0">Alcance milhares de entusiastas em todo o Brasil. Cadastre-se e comece a anunciar hoje mesmo.</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a asp-controller="Produto" asp-action="Criar" class="btn btn-success px-3">
                            <i class="icon-base ri ri-store-3-line me-1"></i> Anunciar Agora
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cards Realocados (Clube VIP & Dica de Cultivo via JSON) -->
        <div class="row g-4 mb-5">
            <!-- Card: Clube de Vantagens VIP -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, #1E3A2B 0%, #4A7C59 100%); color: #fff;">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
                        <div>
                            <div class="avatar avatar-lg mx-auto mb-3 bg-white text-success rounded-circle shadow-sm">
                                <i class="icon-base ri ri-vip-crown-line fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-2">Clube Bonsai VIP</h5>
                            <p class="text-white-50 small mb-3">
                                Assine nosso clube e receba descontos exclusivos em substratos especiais, tesouras de poda japonesas e frete grátis em compras selecionadas.
                            </p>
                        </div>
                        <button class="btn btn-light text-success fw-bold w-100 shadow-sm" onclick="alert('Clube de Vantagens em breve!')">
                            Conhecer o Clube VIP
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card: Dica Rápida de Cultivo (Desacoplada via JSON) -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar bg-label-warning me-3 rounded p-2 d-flex align-items-center justify-content-center">
                                    <i class="icon-base ri ri-lightbulb-line fs-3 text-warning"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0">@(Model.DicaCultivoSemana?.Titulo ?? "Dica de Cultivo da Semana")</h5>
                                    <small class="text-muted">@(Model.DicaCultivoSemana?.Subtitulo ?? "Cuidados Essenciais")</small>
                                </div>
                            </div>
                            <p class="card-text text-body mb-3">
                                @(Model.DicaCultivoSemana?.Conteudo ?? "Sempre regue seu bonsai abundantemente até que a água escorra de forma uniforme pelos furos de drenagem do vaso.")
                            </p>
                        </div>
                        <div class="alert alert-warning mb-0 py-2 px-3 d-flex align-items-center small">
                            <i class="icon-base ri ri-information-line me-2"></i>
                            <span>Categoria: @(Model.DicaCultivoSemana?.Categoria ?? "Geral")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ESPAÇO DE PROPAGANDA INTERMEDIÁRIO: Mesmo tamanho do Clube VIP (2 por linha - col-md-6) -->
        @if (Model.PropagandasIntermediario != null && Model.PropagandasIntermediario.Any())
        {
            <div class="row g-4 mb-5">
                @foreach (var ad in Model.PropagandasIntermediario)
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm overflow-hidden h-100">
                            <a href="@ad.LinkDestino" target="_blank">
                                <img src="@ad.ImagemUrl" class="card-img-top w-100" style="height: 220px; object-fit: cover;" alt="Propaganda Intermediário" />
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ESPAÇO DE PROPAGANDA BÁSICO: Exibido a partir do final das informações da tela inicial (Até 4 por linha - col-md-3) -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0" style="color: #1E3A2B;"><i class="icon-base ri ri-advertisement-line text-success me-2"></i>Anúncios de Parceiros & Viveiros</h5>
                <button class="btn btn-xs btn-outline-success" onclick="abrirModalSolicitarPropaganda()">
                    <i class="icon-base ri ri-add-line me-1"></i> Anunciar Minha Marca
                </button>
            </div>

            @if (Model.PropagandasBasico != null && Model.PropagandasBasico.Any())
            {
                <div class="row g-3">
                    @foreach (var ad in Model.PropagandasBasico)
                    {
                        <div class="col-md-3 col-sm-6">
                            <div class="card border-0 shadow-sm overflow-hidden h-100 hover-top transition">
                                <a href="@ad.LinkDestino" target="_blank">
                                    <img src="@ad.ImagemUrl" class="card-img-top w-100" style="height: 160px; object-fit: cover;" alt="Anúncio Básico" />
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 p-4 text-center bg-light">
                    <p class="text-muted small mb-2">Espaço para até 4 Anúncios Básicos de parceiros.</p>
                    <button class="btn btn-sm btn-success mx-auto" style="max-width: 220px;" onclick="abrirModalSolicitarPropaganda()">
                        <i class="icon-base ri ri-megaphone-line me-1"></i> Adquirir Espaço Básico
                    </button>
                </div>
            }
        </div>

    </div>

    <!-- Coluna Lateral EXCLUSIVA para Viveiros em Destaque, Leilões, Ações e Espaço Econômico -->
    <div class="col-lg-3 col-12 mb-4">

        <!-- Card 1: Carrossel Dinâmico de 'Viveiros em Destaque' -->
        <div class="card mb-4 border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-label-success py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="badge bg-success fw-semibold" style="font-size: 0.75rem;"><i class="icon-base ri ri-award-line me-1"></i>Viveiros em Destaque</span>
                <small class="text-muted"><i class="icon-base ri ri-shield-star-line text-success"></i>Parceiros VIP</small>
            </div>
            
            <div id="carouselViveirosDestaque" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (Model.ViveirosEmDestaque != null && Model.ViveirosEmDestaque.Any())
                    {
                        var first = true;
                        foreach (var v in Model.ViveirosEmDestaque)
                        {
                            <div class="carousel-item @(first ? "active" : "")" data-bs-interval="5000">
                                <div class="card-body p-3 text-center">
                                    <div class="p-3 bg-light rounded mb-3 text-center">
                                        @if (!string.IsNullOrEmpty(v.LogotipoUrl))
                                        {
                                            <img src="@v.LogotipoUrl" alt="@v.Nome" class="img-fluid rounded" style="max-height: 80px; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <i class="icon-base ri ri-store-3-line text-success" style="font-size: 3rem;"></i>
                                        }
                                    </div>
                                    <h6 class="fw-bold mb-1" style="color: #1E3A2B;">@(string.IsNullOrEmpty(v.RazaoSocial) ? v.Nome : v.RazaoSocial)</h6>
                                    <div class="mb-2">
                                        <span class="badge bg-label-warning text-warning fw-semibold" style="font-size: 0.7rem;">
                                            <i class="icon-base ri ri-star-fill me-1"></i>Reputação: @v.Reputacao pts
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-3 text-truncate-2" style="font-size: 0.8rem;">
                                        @(string.IsNullOrEmpty(v.DescricaoViveiro) ? "Viveiro parceiro credenciado no Mercado Bonsai com foco em plantas de alta qualidade." : v.DescricaoViveiro)
                                    </p>
                                    <a asp-controller="Produto" asp-action="Index" asp-route-busca="@(string.IsNullOrEmpty(v.RazaoSocial) ? v.Nome : v.RazaoSocial)" class="btn btn-sm btn-outline-success w-100">
                                        Ver Produtos do Viveiro
                                    </a>
                                </div>
                            </div>
                            first = false;
                        }
                    }
                    else
                    {
                        <div class="carousel-item active">
                            <div class="card-body p-3 text-center">
                                <div class="p-3 bg-light rounded mb-3">
                                    <i class="icon-base ri ri-landscape-line text-success" style="font-size: 2.5rem;"></i>
                                </div>
                                <h6 class="fw-bold mb-1" style="color: #1E3A2B;">Viveiro Shokunin</h6>
                                <p class="text-muted small mb-3">Especialistas em pré-bonsais importados do Japão e ferramentas tradicionais.</p>
                                <a asp-controller="Produto" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Visitar Viveiro</a>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.ViveirosEmDestaque != null && Model.ViveirosEmDestaque.Count() > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselViveirosDestaque" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark bg-opacity-25 rounded-circle" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselViveirosDestaque" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark bg-opacity-25 rounded-circle" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                }
            </div>
        </div>

        <!-- Card 2: Múltiplos Leilões Ativos com Navegação Manual Limpa (Botões Anterior/Próximo) -->
        <div id="carouselLeiloesHome" class="carousel slide mb-4" data-bs-ride="false">
            <div class="carousel-inner">
                @if (Model.LeiloesAtivos != null && Model.LeiloesAtivos.Any())
                {
                    var firstL = true;
                    var idx = 1;
                    var totalL = Model.LeiloesAtivos.Count();
                    foreach (var l in Model.LeiloesAtivos)
                    {
                        <div class="carousel-item @(firstL ? "active" : "")">
                            <div class="card border-0 shadow-sm overflow-hidden hover-top transition">
                                <div class="card-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center text-white">
                                    <span class="badge bg-white text-primary fw-bold" style="font-size: 0.75rem;"><i class="icon-base ri ri-fire-fill me-1"></i>Ao Vivo (@idx/@totalL)</span>
                                    <small class="fw-medium text-white-50"><i class="icon-base ri ri-time-line me-1"></i>@(l.Badge ?? "Em Andamento")</small>
                                </div>
                                <div class="position-relative cursor-pointer" onclick="abrirModalEngajamentoItem('leilao', @l.Id)" title="Clique para abrir galeria e dar lance">
                                    <img src="@l.FotoPrincipalUrl" class="card-img-top img-zoom" alt="@l.Titulo" style="height: 160px; object-fit: cover;" />
                                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-0 m-2">Leilão #@l.Id</span>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-1 text-truncate cursor-pointer" style="color: #1E3A2B;" onclick="abrirModalEngajamentoItem('leilao', @l.Id)">@l.Titulo</h6>
                                    <small class="text-muted d-block mb-2 text-truncate">Vendedor: <strong>@(l.VendedorNome ?? "Cultivador Mercado Bonsai")</strong></small>
                                    
                                    <div class="p-2 bg-light rounded d-flex justify-content-between align-items-center mb-3">
                                        <small class="text-muted">Lance Atual:</small>
                                        <strong class="text-primary fs-6" id="cardLanceLeilao_@l.Id">R$ @l.LanceAtual.ToString("N2")</strong>
                                    </div>
                                    
                                    <button class="btn btn-sm btn-primary w-100 shadow-sm" onclick="abrirModalEngajamentoItem('leilao', @l.Id)">
                                        <i class="icon-base ri ri-auction-line me-1"></i> Dar Lance / Detalhes
                                    </button>
                                </div>
                            </div>
                        </div>
                        firstL = false;
                        idx++;
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <div class="card border-0 shadow-sm p-4 text-center">
                            <i class="icon-base ri ri-auction-line text-muted fs-1 mb-2"></i>
                            <p class="text-muted small mb-0">Nenhum leilão ativo no momento.</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Navegação Manual Limpa (Botões Anterior/Próximo) em uma linha abaixo do botão de lance -->
            @if (Model.LeiloesAtivos != null && Model.LeiloesAtivos.Count() > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light rounded-bottom border-top">
                    <button class="btn btn-xs btn-outline-primary py-1 px-2" type="button" data-bs-target="#carouselLeiloesHome" data-bs-slide="prev">
                        <i class="icon-base ri ri-arrow-left-s-line me-1"></i> Anterior
                    </button>
                    <small class="text-muted fw-bold" style="font-size: 0.75rem;">Leilões Ativos</small>
                    <button class="btn btn-xs btn-outline-primary py-1 px-2" type="button" data-bs-target="#carouselLeiloesHome" data-bs-slide="next">
                        Próximo <i class="icon-base ri ri-arrow-right-s-line ms-1"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Card 3: Ação entre Amigos (Banco de Dados + Modal JS Dinâmico) -->
        @if (Model.RifaAtiva != null)
        {
            <div class="card mb-4 border-0 shadow-sm overflow-hidden hover-top transition">
                <div class="card-header bg-success py-2 px-3 d-flex justify-content-between align-items-center text-white">
                    <span class="badge bg-white text-success fw-bold" style="font-size: 0.75rem;"><i class="icon-base ri ri-ticket-2-fill me-1"></i>Ação entre Amigos</span>
                    <small class="fw-medium text-white-50" id="rifaCotasVendidas_@Model.RifaAtiva.Id">@Model.RifaAtiva.CotasVendidas/@Model.RifaAtiva.TotalCotas Cotas</small>
                </div>
                <div class="position-relative cursor-pointer" onclick="abrirModalEngajamentoItem('rifa', @Model.RifaAtiva.Id)" title="Clique para abrir galeria e cotas">
                    <img src="@Model.RifaAtiva.FotoPrincipalUrl" class="card-img-top img-zoom" alt="@Model.RifaAtiva.Titulo" style="height: 160px; object-fit: cover;" />
                    <span class="badge bg-label-success position-absolute bottom-0 start-0 m-2">R$ @Model.RifaAtiva.ValorCota.ToString("N2") / Cota</span>
                </div>
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-1 cursor-pointer" style="color: #1E3A2B;" onclick="abrirModalEngajamentoItem('rifa', @Model.RifaAtiva.Id)">@Model.RifaAtiva.Titulo</h6>
                    <small class="text-muted d-block mb-2">Apuração: @Model.RifaAtiva.DataSorteio.ToString("dd/MM/yyyy")</small>

                    <!-- Barra de Progresso de Bilhetes Vendidos -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted" style="font-size: 0.75rem;">Progresso das cotas:</small>
                            <small class="fw-bold text-success" id="rifaPorcentagemTexto_@Model.RifaAtiva.Id" style="font-size: 0.75rem;">@Model.RifaAtiva.PorcentagemVendida% vendidas</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="rifaProgressoBar_@Model.RifaAtiva.Id" role="progressbar" style="width: @Model.RifaAtiva.PorcentagemVendida%;" aria-valuenow="@Model.RifaAtiva.PorcentagemVendida" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-success w-100" onclick="abrirModalEngajamentoItem('rifa', @Model.RifaAtiva.Id)">
                        <i class="icon-base ri ri-ticket-line me-1"></i> Adquirir Cotas / Galeria
                    </button>
                </div>
            </div>
        }

        <!-- Card 4: ESPAÇO DE PROPAGANDA ECONÔMICO (Card Lateral Compacto) -->
        @if (Model.PropagandasEconomico != null && Model.PropagandasEconomico.Any())
        {
            @foreach (var ad in Model.PropagandasEconomico)
            {
                <div class="card mb-4 border-0 shadow-sm overflow-hidden hover-top transition">
                    <div class="card-header bg-label-secondary py-1 px-3 d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Patrocinado</span>
                        <small class="text-muted" style="font-size: 0.7rem;">Espaço Econômico</small>
                    </div>
                    <a href="@ad.LinkDestino" target="_blank">
                        <img src="@ad.ImagemUrl" class="card-img-top w-100" style="height: 140px; object-fit: cover;" alt="Anúncio Econômico Lateral" />
                    </a>
                </div>
            }
        }
        
        <div class="card border-0 shadow-sm text-center p-3" style="border: 2px dashed #4A7C59 !important; background-color: #F4F8F5;">
            <div class="card-body p-0">
                <i class="icon-base ri ri-advertisement-line text-success mb-2" style="font-size: 2rem;"></i>
                <h6 class="fw-bold mb-1" style="color: #1E3A2B;">Anuncie seu Viveiro Aqui</h6>
                <p class="text-muted small mb-3">Destaque sua marca para milhares de bonsaístas em todo o Brasil.</p>
                <button class="btn btn-sm btn-success w-100" onclick="abrirModalSolicitarPropaganda()">
                    <i class="icon-base ri ri-megaphone-line me-1"></i> Solicitar Espaço Publicitário
                </button>
            </div>
        </div>

    </div>
</div>

<!-- MODAL INTERATIVO UNIFICADO (XL): Seleção de Espaço + Upload + Live Preview nas Proporções Exatas -->
<div class="modal fade" id="modalSolicitarPropaganda" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold text-white mb-0">
                    <i class="icon-base ri ri-megaphone-line me-2"></i>Espaços de Propaganda & Publicidade - Mercado Bonsai
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4">Escolha a categoria visual desejada para divulgar seu viveiro, produtos ou serviços no maior portal de bonsais do país:</p>

                <!-- Seleção Interativa dos 4 Tipos de Espaços Visuais -->
                <div class="row g-3 mb-4">
                    <!-- Espaço 1: Econômico -->
                    <div class="col-md-3">
                        <div class="card h-100 border-2 card-opcao-ad cursor-pointer p-3 text-center" id="cardOpt_Economico" onclick="selecionarTipoAd('Economico', 49.90, 'cardOpt_Economico')">
                            <span class="badge bg-secondary mb-2 mx-auto" style="width: max-content;">Barra Lateral</span>
                            <h6 class="fw-bold mb-1 text-dark">Econômico</h6>
                            <h5 class="fw-bold text-success mb-2">R$ 49,90<small class="text-muted fs-6">/mês</small></h5>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">Card compacto exibido na barra lateral direita do site.</p>
                        </div>
                    </div>
                    <!-- Espaço 2: Básico -->
                    <div class="col-md-3">
                        <div class="card h-100 border-2 card-opcao-ad cursor-pointer p-3 text-center active-ad-card" id="cardOpt_Basico" onclick="selecionarTipoAd('Basico', 79.90, 'cardOpt_Basico')">
                            <span class="badge bg-success mb-2 mx-auto" style="width: max-content;">Base da Home (Grid 4)</span>
                            <h6 class="fw-bold mb-1 text-dark">Básico</h6>
                            <h5 class="fw-bold text-success mb-2">R$ 79,90<small class="text-muted fs-6">/mês</small></h5>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">Card padrão na base da tela inicial em linha de até 4 anúncios.</p>
                        </div>
                    </div>
                    <!-- Espaço 3: Intermediário -->
                    <div class="col-md-3">
                        <div class="card h-100 border-2 card-opcao-ad cursor-pointer p-3 text-center" id="cardOpt_Intermediario" onclick="selecionarTipoAd('Intermediario', 149.90, 'cardOpt_Intermediario')">
                            <span class="badge bg-info text-dark mb-2 mx-auto" style="width: max-content;">Grid 2 (Tam. Clube VIP)</span>
                            <h6 class="fw-bold mb-1 text-dark">Intermediário</h6>
                            <h5 class="fw-bold text-success mb-2">R$ 149,90<small class="text-muted fs-6">/mês</small></h5>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">Card de destaque do tamanho do Clube VIP em linha de 2 anúncios.</p>
                        </div>
                    </div>
                    <!-- Espaço 4: Avançado -->
                    <div class="col-md-3">
                        <div class="card h-100 border-2 card-opcao-ad cursor-pointer p-3 text-center" id="cardOpt_Avancado" onclick="selecionarTipoAd('Avancado', 299.90, 'cardOpt_Avancado')">
                            <span class="badge bg-primary mb-2 mx-auto" style="width: max-content;">Banner Full Topo</span>
                            <h6 class="fw-bold mb-1 text-dark">Avançado</h6>
                            <h5 class="fw-bold text-success mb-2">R$ 299,90<small class="text-muted fs-6">/mês</small></h5>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">Banner Full de largura total (1 por linha) com máxima visibilidade.</p>
                        </div>
                    </div>
                </div>

                <!-- Formulário de Upload e Live Preview em Tempo Real -->
                <div class="row g-4 pt-3 border-top">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3"><i class="icon-base ri ri-upload-cloud-line me-1 text-success"></i>Dados do Anúncio & Arte</h6>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Espaço Selecionado:</label>
                            <input type="text" id="adTipoSelecionadoDisplay" class="form-control form-control-sm bg-light fw-bold text-success" value="Básico - R$ 79,90 / mês" readonly />
                            <input type="hidden" id="adTipoInput" value="Basico" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Link de Destino ao Clicar (Site / WhatsApp / Instagram):</label>
                            <input type="url" id="adLinkDestinoInput" class="form-control form-control-sm" placeholder="https://seu-site.com.br ou https://wa.me/55..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Anexar Arte / Imagem do Anúncio:</label>
                            <input type="file" id="adArteFileInput" class="form-control form-control-sm" accept="image/*" onchange="atualizarLivePreview(this)" />
                            <small class="text-muted d-block mt-1">Formatos suportados: PNG, JPG, WEBP.</small>
                        </div>
                    </div>

                    <!-- Coluna de Live Preview em Tempo Real nas Proporções Exatas -->
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3"><i class="icon-base ri ri-eye-line me-1 text-success"></i>Pré-visualização ao Vivo (Proporções Exatas)</h6>
                        <div class="p-3 bg-light rounded border text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 240px;" id="containerLivePreviewAd">
                            
                            <!-- Box de Preview Dinâmico Ajustado via JS -->
                            <div id="boxPreviewProporcional" class="border rounded overflow-hidden bg-white shadow-sm w-100" style="height: 160px; transition: all 0.3s ease;">
                                <img id="imgLivePreview" src="~/starter-kit/assets/img/logo.png" class="w-100 h-100" style="object-fit: cover;" alt="Preview Arte" />
                            </div>
                            <small class="text-muted mt-2 fw-semibold" id="legendaPreviewDimensao">Exibição no Formato da Categoria: Básico (Grid 4)</small>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success px-4 shadow-sm" onclick="enviarSolicitarPropagandaReal()">
                    <i class="icon-base ri ri-send-plane-fill me-1"></i> Confirmar & Solicitar Espaço (Status Pendente)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Único de Galeria e Engajamento (Bootstrap Injetado com Dados do Banco) -->
<div class="modal fade" id="modalDetalhesEngajamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0" id="modalHeaderBg">
                <h5 class="modal-title fw-bold" id="modalEngajamentoTitulo">Detalhes do Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalEngajamentoCorpo">
                <!-- Conteúdo Injetado Dinamicamente via JavaScript -->
            </div>
            <div class="modal-footer border-0 pt-0" id="modalEngajamentoRodape">
                <!-- Botões Injetados Dinamicamente -->
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .cursor-pointer { cursor: pointer; }
        .hover-opacity-100:hover { opacity: 1 !important; }
        .img-zoom { transition: transform 0.3s ease; }
        .position-relative:hover .img-zoom { transform: scale(1.03); }
        .thumb-gallery { cursor: pointer; opacity: 0.7; transition: opacity 0.2s, border-color 0.2s; }
        .thumb-gallery.active, .thumb-gallery:hover { opacity: 1; border: 2px solid #4A7C59 !important; }
        .card-opcao-ad { transition: all 0.2s ease-in-out; border-color: #e0e0e0; }
        .card-opcao-ad:hover { transform: translateY(-4px); border-color: #4A7C59; }
        .active-ad-card { border-color: #4A7C59 !important; background-color: #F4F8F5; }
    </style>
}

@section Scripts {
    <script>
        function abrirModalSolicitarPropaganda() {
            const modalEl = document.getElementById('modalSolicitarPropaganda');
            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
        }

        function selecionarTipoAd(tipo, preco, cardId) {
            document.querySelectorAll('.card-opcao-ad').forEach(c => c.classList.remove('active-ad-card'));
            const cardEl = document.getElementById(cardId);
            if (cardEl) cardEl.classList.add('active-ad-card');

            document.getElementById('adTipoInput').value = tipo;
            document.getElementById('adTipoSelecionadoDisplay').value = `${tipo} - R$ ${preco.toFixed(2).replace('.', ',')} / mês`;

            const boxPreview = document.getElementById('boxPreviewProporcional');
            const legenda = document.getElementById('legendaPreviewDimensao');

            if (tipo === 'Economico') {
                boxPreview.style.height = '140px';
                boxPreview.style.width = '70%';
                legenda.innerText = 'Exibição no Formato da Categoria: Econômico (Barra Lateral 70%)';
            } else if (tipo === 'Basico') {
                boxPreview.style.height = '160px';
                boxPreview.style.width = '100%';
                legenda.innerText = 'Exibição no Formato da Categoria: Básico (Grid 4 - 100%)';
            } else if (tipo === 'Intermediario') {
                boxPreview.style.height = '220px';
                boxPreview.style.width = '100%';
                legenda.innerText = 'Exibição no Formato da Categoria: Intermediario (Grid 2 - Tam. Clube VIP)';
            } else if (tipo === 'Avancado') {
                boxPreview.style.height = '120px';
                boxPreview.style.width = '100%';
                legenda.innerText = 'Exibição no Formato da Categoria: Avançado (Banner Full 100%)';
            }
        }

        function atualizarLivePreview(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imgLivePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function enviarSolicitarPropagandaReal() {
            const tipoEspaco = document.getElementById('adTipoInput').value;
            const linkDestino = document.getElementById('adLinkDestinoInput').value;
            const fileInput = document.getElementById('adArteFileInput');

            try {
                const formData = new FormData();
                formData.append('tipoEspaco', tipoEspaco);
                formData.append('linkDestino', linkDestino);
                if (fileInput.files && fileInput.files[0]) {
                    formData.append('arteImagem', fileInput.files[0]);
                }

                const response = await fetch('/Propaganda/SolicitarComArte', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.status === 401) {
                    alert('Você precisa estar logado no portal para solicitar espaços publicitários.');
                    window.location.href = '/Conta/Login';
                    return;
                }

                const data = await response.json();
                if (data.sucesso) {
                    alert('🎉 ' + data.mensagem);
                    const modalEl = bootstrap.Modal.getInstance(document.getElementById('modalSolicitarPropaganda'));
                    if (modalEl) modalEl.hide();
                    window.location.href = '/Propaganda/MinhasPropagandas';
                } else {
                    alert('⚠️ ' + data.mensagem);
                }
            } catch (err) {
                console.error(err);
                alert('Erro ao enviar a solicitação. Verifique sua conexão e tente novamente.');
            }
        }

        // Mapeamento dinâmico de leilões e ações ativas alimentados pelo PostgreSQL/Supabase
        const listaLeiloesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.LeiloesAtivos ?? new List<MercadoBonsai.Domain.Entities.Leilao>()).Select(l => new {
            tipo = "leilao",
            id = l.Id,
            titulo = "⚡ " + l.Titulo,
            subtitulo = l.Subtitulo,
            descricao = l.Descricao,
            fotoPrincipal = l.FotoPrincipalUrl,
            fotoDetalhe = string.IsNullOrEmpty(l.FotoDetalheUrl) ? l.FotoPrincipalUrl : l.FotoDetalheUrl,
            badge = l.Badge ?? "Ao Vivo",
            lanceAtual = "R$ " + l.LanceAtual.ToString("N2"),
            proximoLanceMin = l.ProximoLanceMinimo,
            vendedor = l.VendedorNome ?? "Cultivador Mercado Bonsai",
            historicoLances = l.Lances != null ? l.Lances.Select(h => new {
                usuario = h.UsuarioNome,
                valor = "R$ " + h.Valor.ToString("N2"),
                hora = h.DataLance.ToString("dd/MM HH:mm")
            }) : null
        })));

        const rifaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RifaAtiva != null ? new {
            tipo = "rifa",
            id = Model.RifaAtiva.Id,
            titulo = "🎟️ " + Model.RifaAtiva.Titulo,
            subtitulo = Model.RifaAtiva.Subtitulo,
            descricao = Model.RifaAtiva.Descricao,
            fotoPrincipal = Model.RifaAtiva.FotoPrincipalUrl,
            fotoDetalhe = string.IsNullOrEmpty(Model.RifaAtiva.FotoDetalheUrl) ? Model.RifaAtiva.FotoPrincipalUrl : Model.RifaAtiva.FotoDetalheUrl,
            badge = $"{Model.RifaAtiva.PorcentagemVendida}% das cotas vendidas ({Model.RifaAtiva.CotasVendidas} / {Model.RifaAtiva.TotalCotas})",
            precoCota = Model.RifaAtiva.ValorCota,
            totalCotas = Model.RifaAtiva.TotalCotas,
            cotasVendidas = Model.RifaAtiva.CotasVendidas,
            vendedor = Model.RifaAtiva.VendedorNome ?? "Mercado Bonsai Oficial"
        } : null));

        function trocarFotoModal(src, el) {
            document.getElementById('modalFotoPrincipalDisplay').src = src;
            document.querySelectorAll('.thumb-gallery').forEach(t => t.classList.remove('active'));
            if(el) el.classList.add('active');
        }

        function atualizarTotalRifa(precoUnitario) {
            const qtd = parseInt(document.getElementById('qtdCotasRifa').value) || 1;
            const total = qtd * precoUnitario;
            document.getElementById('totalCalculadoRifa').innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
        }

        function abrirModalEngajamentoItem(tipo, id) {
            let item = null;
            if (tipo === 'leilao') {
                item = listaLeiloesData.find(l => l.id === id) || listaLeiloesData[0];
            } else {
                item = rifaData;
            }

            if (!item) {
                alert('Informações do ' + tipo + ' indisponíveis no momento.');
                return;
            }

            const modalEl = document.getElementById('modalDetalhesEngajamento');
            const tituloEl = document.getElementById('modalEngajamentoTitulo');
            const corpoEl = document.getElementById('modalEngajamentoCorpo');
            const rodapeEl = document.getElementById('modalEngajamentoRodape');

            tituloEl.innerText = item.titulo;

            let htmlBody = `
                <div class="row g-4">
                    <div class="col-md-6">
                        <!-- Foto Principal Display -->
                        <div class="position-relative overflow-hidden rounded mb-3 shadow-sm" style="height: 280px; background-color: #f8f9fa;">
                            <img id="modalFotoPrincipalDisplay" src="${item.fotoPrincipal}" class="w-100 h-100" style="object-fit: cover;" alt="${item.titulo}" />
                        </div>
                        <!-- Miniaturas de Galeria -->
                        <div class="d-flex gap-2">
                            <img src="${item.fotoPrincipal}" class="thumb-gallery rounded active" style="width: 70px; height: 70px; object-fit: cover;" onclick="trocarFotoModal('${item.fotoPrincipal}', this)" />
                            <img src="${item.fotoDetalhe}" class="thumb-gallery rounded" style="width: 70px; height: 70px; object-fit: cover;" onclick="trocarFotoModal('${item.fotoDetalhe}', this)" />
                        </div>
                    </div>
                    <div class="col-md-6 d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge ${item.tipo === 'leilao' ? 'bg-primary' : 'bg-success'} px-3 py-2 fs-6 mb-3">
                                ${item.badge}
                            </span>
                            <p class="text-muted small mb-2">${item.subtitulo || ''}</p>
                            <p class="text-body small mb-3">${item.descricao || ''}</p>

                            <div class="card bg-light border-0 p-3 mb-3">
                                <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.85rem;">Organizador / Vendedor:</h6>
                                <small class="text-primary fw-bold">${item.vendedor}</small>
                            </div>
                        </div>
            `;

            if (item.tipo === 'leilao') {
                htmlBody += `
                        <div>
                            <div class="p-3 bg-label-primary rounded mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Lance Mais Alto Atual:</span>
                                    <strong class="text-primary fs-4" id="modalLanceAtualDisplay">${item.lanceAtual}</strong>
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">R$</span>
                                    <input type="number" id="valorLanceInput" class="form-control" value="${item.proximoLanceMin}" step="50" min="${item.proximoLanceMin}" />
                                </div>
                                <small class="text-muted d-block mt-1">Incremento mínimo exigido pelo vendedor</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Histórico Recente de Lances do Banco -->
                <div class="mt-4 pt-3 border-top">
                    <h6 class="fw-bold mb-3"><i class="icon-base ri ri-history-line me-1"></i>Últimos Lances Registrados</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Usuário</th>
                                    <th>Valor</th>
                                    <th>Momento</th>
                                </tr>
                            </thead>
                            <tbody id="modalTabelaLancesBody">
                                ${(item.historicoLances && item.historicoLances.length > 0) ? item.historicoLances.map(l => `
                                    <tr>
                                        <td>${l.usuario}</td>
                                        <td class="fw-bold text-primary">${l.valor}</td>
                                        <td class="text-muted">${l.hora}</td>
                                    </tr>
                                `).join('') : '<tr><td colspan="3" class="text-muted">Nenhum lance registrado ainda. Seja o primeiro!</td></tr>'}
                            </tbody>
                        </table>
                    </div>
                </div>
                `;

                rodapeEl.innerHTML = `
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-primary px-4" onclick="confirmarLanceReal(${item.id})">
                        <i class="icon-base ri ri-auction-line me-1"></i> Confirmar Lance no Banco
                    </button>
                `;
            } else {
                htmlBody += `
                        <div>
                            <div class="p-3 bg-label-success rounded mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Preço por Cota:</span>
                                    <strong class="text-success fs-5">R$ ${item.precoCota.toFixed(2).replace('.', ',')}</strong>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Selecione a quantidade de cotas:</label>
                                    <div class="d-flex gap-2">
                                        <select id="qtdCotasRifa" class="form-select form-select-sm" onchange="atualizarTotalRifa(${item.precoCota})">
                                            <option value="1">1 Cota (R$ ${item.precoCota.toFixed(2).replace('.', ',')})</option>
                                            <option value="2">2 Cotas (R$ ${(item.precoCota * 2).toFixed(2).replace('.', ',')})</option>
                                            <option value="5" selected>5 Cotas (R$ ${(item.precoCota * 5).toFixed(2).replace('.', ',')}) - Popular</option>
                                            <option value="10">10 Cotas (R$ ${(item.precoCota * 10).toFixed(2).replace('.', ',')})</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="fw-bold small">Total da Compra:</span>
                                    <strong class="text-success fs-5" id="totalCalculadoRifa">R$ ${(item.precoCota * 5).toFixed(2).replace('.', ',')}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                `;

                rodapeEl.innerHTML = `
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-success px-4" onclick="confirmarRifaReal(${item.id})">
                        <i class="icon-base ri ri-ticket-line me-1"></i> Comprar Cotas (Gerar Pix Simulado)
                    </button>
                `;
            }

            corpoEl.innerHTML = htmlBody;

            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
        }

        async function confirmarLanceReal(leilaoId) {
            const inputVal = document.getElementById('valorLanceInput');
            if (!inputVal) return;
            const valorLance = parseFloat(inputVal.value);
            if (!valorLance || isNaN(valorLance)) {
                alert('Por favor, informe um valor de lance válido.');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('leilaoId', leilaoId);
                formData.append('valorLance', valorLance);

                const response = await fetch('/Leilao/RegistrarLance', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.status === 401) {
                    alert('Você precisa estar logado no sistema para efetuar um lance.');
                    window.location.href = '/Conta/Login';
                    return;
                }

                const data = await response.json();
                if (data.sucesso) {
                    alert(data.mensagem);
                    
                    const lanceAtualEl = document.getElementById('modalLanceAtualDisplay');
                    if (lanceAtualEl) lanceAtualEl.innerText = data.novoLanceAtual;
                    
                    if (inputVal && data.novoProximoMinimo) {
                        inputVal.value = data.novoProximoMinimo;
                        inputVal.min = data.novoProximoMinimo;
                    }

                    const tabelaLancesBody = document.getElementById('modalTabelaLancesBody');
                    if (tabelaLancesBody && data.historicoLances) {
                        tabelaLancesBody.innerHTML = data.historicoLances.map(l => `
                            <tr>
                                <td>${l.usuario}</td>
                                <td class="fw-bold text-primary">${l.valor}</td>
                                <td class="text-muted">${l.hora}</td>
                            </tr>
                        `).join('');
                    }

                    const cardLanceEl = document.querySelector(`#cardLanceLeilao_${leilaoId}`);
                    if (cardLanceEl) cardLanceEl.innerText = data.novoLanceAtual;

                    const modalEl = bootstrap.Modal.getInstance(document.getElementById('modalDetalhesEngajamento'));
                    if (modalEl) modalEl.hide();
                } else {
                    alert('⚠️ ' + data.mensagem);
                }
            } catch (err) {
                console.error(err);
                alert('Erro ao registrar o lance. Verifique sua conexão e tente novamente.');
            }
        }

        async function confirmarRifaReal(rifaId) {
            const selectEl = document.getElementById('qtdCotasRifa');
            if (!selectEl) return;
            const qtd = parseInt(selectEl.value) || 1;

            try {
                const formData = new FormData();
                formData.append('rifaId', rifaId);
                formData.append('quantidadeCotas', qtd);

                const response = await fetch('/Rifa/AdquirirCotas', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.status === 401) {
                    alert('Você precisa estar logado no sistema para adquirir cotas.');
                    window.location.href = '/Conta/Login';
                    return;
                }

                const data = await response.json();
                if (data.sucesso) {
                    const modalEngajamento = bootstrap.Modal.getInstance(document.getElementById('modalDetalhesEngajamento'));
                    if (modalEngajamento) modalEngajamento.hide();

                    const elemCotasVendidas = document.getElementById(`rifaCotasVendidas_${rifaId}`);
                    if (elemCotasVendidas) elemCotasVendidas.innerText = `${data.cotasVendidas}/${data.totalCotas} Cotas`;

                    const elemProgressoBar = document.getElementById(`rifaProgressoBar_${rifaId}`);
                    if (elemProgressoBar) {
                        elemProgressoBar.style.width = `${data.porcentagemVendida}%`;
                        elemProgressoBar.setAttribute('aria-valuenow', data.porcentagemVendida);
                    }

                    const elemPorcentagemTexto = document.getElementById(`rifaPorcentagemTexto_${rifaId}`);
                    if (elemPorcentagemTexto) elemPorcentagemTexto.innerText = `${data.porcentagemVendida}% vendidas`;

                    exibirModalPixSimulado(data);
                } else {
                    alert('⚠️ ' + data.mensagem);
                }
            } catch (err) {
                console.error(err);
                alert('Erro ao registrar a reserva de cotas. Tente novamente.');
            }
        }

        function exibirModalPixSimulado(data) {
            const modalPixHtml = `
                <div class="modal fade" id="modalPixSimulado" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg">
                            <div class="modal-header bg-success text-white py-3">
                                <h5 class="modal-title fw-bold text-white mb-0"><i class="icon-base ri ri-qr-code-line me-2"></i>Pagamento Pix - Ação entre Amigos</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4 text-center">
                                <div class="alert alert-success border-0 py-2 mb-3">
                                    <i class="icon-base ri ri-checkbox-circle-line me-1 fs-5 align-middle"></i>
                                    <strong>Reserva com Status Pendente gravada no banco!</strong>
                                </div>
                                <p class="text-muted small mb-3">Realize o pagamento do Pix fictício abaixo para confirmar suas cotas:</p>

                                <div class="p-3 bg-light rounded d-inline-block shadow-sm mb-3 border border-success">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(data.chavePix)}" alt="QR Code Pix Simulado" class="img-fluid rounded" style="width: 180px; height: 180px;" />
                                </div>

                                <div class="bg-light p-3 rounded mb-3 text-start border">
                                    <div class="d-flex justify-content-between mb-1 small">
                                        <span class="text-muted">Quantidade de Cotas:</span>
                                        <strong class="text-dark">${data.quantidadeCotas} Cota(s)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1 small">
                                        <span class="text-muted">Valor Total do Pix:</span>
                                        <strong class="text-success fs-5">${data.valorTotal}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted">Status da Reserva:</span>
                                        <span class="badge bg-warning text-dark">${data.statusPedido}</span>
                                    </div>
                                </div>

                                <div class="text-start mb-3">
                                    <label class="form-label fw-semibold small text-muted">Chave Pix Copia e Cola (Simulada):</label>
                                    <div class="input-group">
                                        <input type="text" id="inputPixCopiaCola" class="form-control form-control-sm text-truncate bg-white" value="${data.chavePix}" readonly />
                                        <button class="btn btn-sm btn-success" onclick="copiarChavePix()">
                                            <i class="icon-base ri ri-file-copy-line me-1"></i> Copiar
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal" onclick="alert('Simulação de pagamento via Pix concluída!')">
                                    Concluir Simulação de Pagamento
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            const antigo = document.getElementById('modalPixSimulado');
            if (antigo) antigo.remove();

            document.body.insertAdjacentHTML('beforeend', modalPixHtml);
            const bsModalPix = new bootstrap.Modal(document.getElementById('modalPixSimulado'));
            bsModalPix.show();
        }

        function copiarChavePix() {
            const input = document.getElementById('inputPixCopiaCola');
            if (input) {
                input.select();
                navigator.clipboard.writeText(input.value);
                alert('📋 Chave Pix Copia e Cola copiada para a área de transferência!');
            }
        }
    </script>
}

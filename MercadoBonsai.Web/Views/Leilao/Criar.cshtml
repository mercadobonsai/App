@model MercadoBonsai.Domain.Entities.Leilao
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Novo Leilão - Mercado Bonsai";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="icon-base ri ri-auction-line me-2 text-primary"></i>Cadastrar Novo Leilão</h5>
                    <a asp-action="MeusLeiloes" class="btn btn-sm btn-outline-secondary">Voltar</a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Criar" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold">Título do Exemplar</label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ex: Bonsai Shimpaku Itoigawa 35 anos" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subtitulo" class="form-label fw-semibold">Subtítulo / Destaque</label>
                            <input asp-for="Subtitulo" class="form-control" placeholder="Ex: Exemplar Único de Exposição com Jin de tronco" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="LanceAtual" class="form-label fw-semibold">Lance Inicial (R$)</label>
                                <input asp-for="LanceAtual" class="form-control" type="number" step="0.01" value="1200.00" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IncrementoMinimo" class="form-label fw-semibold">Incremento Mínimo (R$)</label>
                                <input asp-for="IncrementoMinimo" class="form-control" type="number" step="1" value="50" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold">Status Inicial</label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusLeilao>()"></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DataFinalizacao" class="form-label fw-semibold">Data e Hora de Término</label>
                            <input asp-for="DataFinalizacao" type="datetime-local" class="form-control" value="@Model.DataFinalizacao.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label fw-semibold">Descrição Detalhada</label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva a procedência, dimensões do vaso, estilo e histórico de cultivo da planta..."></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto Principal</label>
                                <input type="file" name="fotoPrincipal" class="form-control" accept="image/*" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto de Detalhe</label>
                                <input type="file" name="fotoDetalhe" class="form-control" accept="image/*" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="MeusLeiloes" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="icon-base ri ri-save-line me-1"></i> Publicar Leilão</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

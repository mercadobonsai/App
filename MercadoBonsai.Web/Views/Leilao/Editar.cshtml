@model MercadoBonsai.Domain.Entities.Leilao
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = $"Editar Leilão #{Model.Id}";
    var podeEditarGeral = Model.PodeEditarDadosGerais;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="icon-base ri ri-edit-box-line me-2 text-primary"></i>Gerenciar / Alterar Leilão</h5>
                    <a asp-action="MeusLeiloes" class="btn btn-sm btn-outline-secondary">Voltar</a>
                </div>
                <div class="card-body p-4">

                    @if (!podeEditarGeral)
                    {
                        <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
                            <i class="icon-base ri ri-lock-line me-2 fs-5 align-middle"></i>
                            <strong>Atenção (Trava de Segurança):</strong> Este leilão já está <u>Iniciado e possui lances registrados</u>. Para garantir a transparência das disputas, a alteração de dados gerais está bloqueada. <strong>É permitida apenas a prorrogação da data de término!</strong>
                        </div>
                    }

                    <form id="formEditarLeilao" asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FotoPrincipalUrl" />
                        <input type="hidden" asp-for="FotoDetalheUrl" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto Principal</label>
                                <div class="mb-2">
                                    @if (!string.IsNullOrEmpty(Model.FotoPrincipalUrl))
                                    {
                                        <img id="imgPrincipalAtual" src="@Model.FotoPrincipalUrl" onerror="this.onerror=null;this.src='https://cdn.mercadobonsai.com.br/padrao/shimpaku_leilao.webp';" alt="Foto Principal" class="img-fluid rounded shadow-sm border" style="max-height: 150px; width: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded p-3 text-muted small border">Sem foto principal</div>
                                    }
                                </div>
                                @if (podeEditarGeral)
                                {
                                    <input type="file" name="fotoPrincipal" id="fotoPrincipal" class="form-control" accept="image/*" />
                                    <small class="text-muted d-block mt-1">Selecione para substituir a foto principal (otimizada no navegador).</small>
                                    <div id="previewPrincipalContainer" class="mt-2 d-none">
                                        <small class="fw-semibold text-success d-block mb-1">Nova Foto Selecionada:</small>
                                        <img id="imgPreviewPrincipal" src="" class="img-fluid rounded border shadow-sm" style="max-height: 140px; width: 100%; object-fit: cover;" alt="Prévia da Nova Foto Principal" />
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto de Detalhe</label>
                                <div class="mb-2">
                                    @if (!string.IsNullOrEmpty(Model.FotoDetalheUrl))
                                    {
                                        <img id="imgDetalheAtual" src="@Model.FotoDetalheUrl" onerror="this.onerror=null;this.src='https://cdn.mercadobonsai.com.br/padrao/shimpaku_detalhe.webp';" alt="Foto de Detalhe" class="img-fluid rounded shadow-sm border" style="max-height: 150px; width: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded p-3 text-muted small border">Sem foto de detalhe</div>
                                    }
                                </div>
                                @if (podeEditarGeral)
                                {
                                    <input type="file" name="fotoDetalhe" id="fotoDetalhe" class="form-control" accept="image/*" />
                                    <small class="text-muted d-block mt-1">Selecione para substituir a foto de detalhe.</small>
                                    <div id="previewDetalheContainer" class="mt-2 d-none">
                                        <small class="fw-semibold text-success d-block mb-1">Nova Foto Selecionada:</small>
                                        <img id="imgPreviewDetalhe" src="" class="img-fluid rounded border shadow-sm" style="max-height: 140px; width: 100%; object-fit: cover;" alt="Prévia da Nova Foto de Detalhe" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold"></label>
                            <input asp-for="Titulo" class="form-control" readonly="@(!podeEditarGeral)" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subtitulo" class="form-label fw-semibold"></label>
                            <input asp-for="Subtitulo" class="form-control" readonly="@(!podeEditarGeral)" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="LanceAtual" class="form-label fw-semibold"></label>
                                <input asp-for="LanceAtual" class="form-control" type="number" step="0.01" readonly="@(!podeEditarGeral)" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IncrementoMinimo" class="form-label fw-semibold"></label>
                                <input asp-for="IncrementoMinimo" class="form-control" type="number" step="1" readonly="@(!podeEditarGeral)" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusLeilao>()"></select>
                            </div>
                        </div>

                        <div class="mb-3 bg-label-warning p-3 rounded">
                            <label asp-for="DataFinalizacao" class="form-label fw-bold text-dark">
                                <i class="icon-base ri ri-calendar-event-line me-1"></i> Data e Hora de Término (Prorrogação Permite Apenas Extensão)
                            </label>
                            <input asp-for="DataFinalizacao" type="datetime-local" class="form-control" value="@Model.DataFinalizacao.ToString("yyyy-MM-ddTHH:mm")" />
                            <small class="text-muted mt-1 d-block">Caso necessário, aumente o prazo de encerramento para dar mais tempo às disputas.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" readonly="@(!podeEditarGeral)"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="MeusLeiloes" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" id="btnSubmitEditarLeilao" class="btn btn-primary px-4">
                                <i class="icon-base ri ri-save-line me-1"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
    <script>
        async function otimizarInputImagem(fileInput, imgPreview, previewContainer) {
            if (!fileInput) return;

            fileInput.addEventListener('change', async function (e) {
                let file = e.target.files[0];
                if (!file) {
                    if (previewContainer) previewContainer.classList.add('d-none');
                    return;
                }

                // Suporte para fotos Apple (HEIC / HEIF)
                const isHeic = file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif') || file.type === 'image/heic';
                if (isHeic && typeof heic2any !== 'undefined') {
                    try {
                        const blobResult = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.85 });
                        const singleBlob = Array.isArray(blobResult) ? blobResult[0] : blobResult;
                        file = new File([singleBlob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                        const dt = new DataTransfer();
                        dt.items.add(file);
                        fileInput.files = dt.files;
                    } catch (heicErr) {
                        console.warn('Conversão de HEIC no cliente ignorada:', heicErr);
                    }
                }

                if (!file.type.startsWith('image/')) return;

                if (imgPreview && previewContainer) {
                    imgPreview.src = URL.createObjectURL(file);
                    previewContainer.classList.remove('d-none');
                }

                if (file.size > 800 * 1024) {
                    try {
                        const img = new Image();
                        img.src = URL.createObjectURL(file);
                        await img.decode();

                        const maxDim = 1600;
                        let width = img.width;
                        let height = img.height;

                        if (width > maxDim || height > maxDim) {
                            if (width > height) {
                                height = Math.round((height * maxDim) / width);
                                width = maxDim;
                            } else {
                                width = Math.round((width * maxDim) / height);
                                height = maxDim;
                            }
                        }

                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob(function (blob) {
                            if (blob && blob.size < file.size) {
                                const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                                const dt = new DataTransfer();
                                dt.items.add(newFile);
                                fileInput.files = dt.files;
                                if (imgPreview) imgPreview.src = URL.createObjectURL(newFile);
                            }
                        }, 'image/jpeg', 0.85);
                    } catch (err) {
                        console.warn('Otimização de imagem no navegador ignorada:', err);
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            otimizarInputImagem(
                document.getElementById('fotoPrincipal'),
                document.getElementById('imgPreviewPrincipal'),
                document.getElementById('previewPrincipalContainer')
            );

            otimizarInputImagem(
                document.getElementById('fotoDetalhe'),
                document.getElementById('imgPreviewDetalhe'),
                document.getElementById('previewDetalheContainer')
            );

            const form = document.getElementById('formEditarLeilao');
            const btn = document.getElementById('btnSubmitEditarLeilao');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Salvando alterações...';
                });
            }
        });
    </script>
}

@model IEnumerable<MercadoBonsai.Domain.Entities.Notificacao>
@{
    ViewData["Title"] = "Minhas Notificações - Mercado Bonsai";
    int totalNaoLidas = ViewBag.TotalNaoLidas as int? ?? 0;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: #4A7C59;">
                <i class="icon-base ri ri-notification-3-line me-2"></i>Minhas Notificações
            </h3>
            <p class="text-muted mb-0">Avisos importantes, comunicados da plataforma e atualizações da sua conta</p>
        </div>
        @if (totalNaoLidas > 0)
        {
            <button type="button" class="btn btn-outline-success shadow-sm" onclick="marcarTodasLidasPagina()">
                <i class="icon-base ri ri-check-double-line me-1"></i> Marcar todas como lidas
            </button>
        }
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <i class="icon-base ri ri-checkbox-circle-line me-2 fs-5 align-middle"></i>
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="icon-base ri ri-mail-line me-2"></i>Histórico de Mensagens
            </h6>
            @if (totalNaoLidas > 0)
            {
                <span class="badge bg-danger rounded-pill">@totalNaoLidas não lidas</span>
            }
            else
            {
                <span class="badge bg-success rounded-pill">Todas as mensagens lidas</span>
            }
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in Model)
                    {
                        var iconClass = "ri-information-line text-info";
                        var bgClass = "bg-label-info";
                        if (n.Tipo == "Alerta")
                        {
                            iconClass = "ri-alert-line text-warning";
                            bgClass = "bg-label-warning";
                        }
                        else if (n.Tipo == "Sucesso")
                        {
                            iconClass = "ri-checkbox-circle-line text-success";
                            bgClass = "bg-label-success";
                        }
                        else if (n.Tipo == "Urgente")
                        {
                            iconClass = "ri-alarm-warning-line text-danger";
                            bgClass = "bg-label-danger";
                        }

                        <div class="list-group-item p-4 border-bottom @(!n.Lida ? "bg-light-subtle" : "")" id="notif-item-@n.Id">
                            <div class="d-flex align-items-start">
                                <div class="avatar avatar-md me-3 flex-shrink-0">
                                    <span class="avatar-initial rounded-circle @bgClass">
                                        <i class="icon-base ri @iconClass fs-4"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="mb-0 fw-bold text-dark fs-6">@n.Titulo</h6>
                                            @if (!n.Lida)
                                            {
                                                <span class="badge bg-danger badge-dot" style="width: 8px; height: 8px; border-radius: 50%;"></span>
                                                <span class="badge bg-label-danger py-1 px-2 small">Nova</span>
                                            }
                                        </div>
                                        <small class="text-muted">@n.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-2 text-secondary" style="line-height: 1.5;">@n.Mensagem</p>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(n.LinkUrl))
                                        {
                                            <a href="@n.LinkUrl" class="btn btn-sm btn-success" onclick="marcarIndividual(@n.Id)">
                                                <i class="icon-base ri ri-external-link-line me-1"></i> Acessar Link
                                            </a>
                                        }
                                        @if (!n.Lida)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="marcarIndividual(@n.Id)">
                                                <i class="icon-base ri ri-check-line me-1"></i> Marcar como Lida
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="icon-base ri ri-notification-off-line fs-1 text-muted d-block mb-3"></i>
                    <h5 class="fw-bold text-muted mb-1">Você não possui notificações</h5>
                    <p class="text-muted small mb-0">Quando a administração enviar comunicados ou avisos, eles aparecerão aqui.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function marcarIndividual(id) {
            fetch('/Notificacao/MarcarLida', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id })
            }).then(function() {
                location.reload();
            });
        }

        function marcarTodasLidasPagina() {
            fetch('/Notificacao/MarcarTodasLidas', {
                method: 'POST'
            }).then(function() {
                location.reload();
            });
        }
    </script>
}

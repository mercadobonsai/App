@model IEnumerable<MercadoBonsai.Domain.Entities.Pedido>
@{
    ViewData["Title"] = "Minhas Compras";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #4A7C59;">
            <i class="icon-base ri ri-shopping-bag-3-line me-2"></i>Minhas Compras
        </h3>
        <p class="text-muted mb-0">Acompanhe o status e a esteira de entrega dos seus pedidos no Mercado Bonsai.</p>
    </div>
    <div>
        <a asp-controller="Produto" asp-action="Index" class="btn btn-outline-success">
            <i class="icon-base ri ri-store-2-line me-1"></i> Ir para a Vitrine
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body py-5">
            <i class="icon-base ri ri-shopping-cart-2-line fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Você ainda não realizou nenhum pedido</h5>
            <p class="text-muted mb-4">Explore a nossa vitrine de Bonsais, Insumos e Cerâmicas para fazer sua primeira compra.</p>
            <a asp-controller="Produto" asp-action="Index" class="btn btn-success">
                <i class="icon-base ri ri-store-line me-1"></i> Explorar Vitrine
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var pedido in Model)
        {
            string badgeClass = pedido.StatusPedido switch
            {
                "Criado" => "bg-secondary text-white",
                "Aguardando Aceite" => "bg-warning text-white",
                "Recusado" => "bg-danger text-white",
                "Aguardando Pagamento" => "bg-info text-white",
                "Pago" => "bg-success text-white",
                "Em Despacho" => "bg-primary text-white",
                "Em Transito" => "bg-primary text-white",
                "Entregue" => "bg-info text-white",
                "Conferido" => "bg-success text-white",
                "Finalizado" => "bg-dark text-white",
                _ => "bg-secondary text-white"
            };

            <div class="col-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light d-flex flex-wrap align-items-center justify-content-between py-3">
                        <div>
                            <span class="fw-bold text-dark fs-5">Pedido #@pedido.Numero</span>
                            @if (pedido.LeilaoId.HasValue && pedido.LeilaoId.Value > 0)
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="icon-base ri ri-auction-line me-1"></i>
                                    @(pedido.PosicaoVencedorLeilao == 1 ? "🏆 1º Colocado (Vendedor)" : $"🔄 {pedido.PosicaoVencedorLeilao}º Colocado (Chamada Sequencial)")
                                </span>
                            }
                            <span class="text-muted ms-2 fs-7">Realizado em @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div>
                            <span class="badge @badgeClass fs-6 px-3 py-2">
                                <i class="icon-base ri ri-checkbox-blank-circle-fill me-1 fs-8"></i>@pedido.StatusPedido
                            </span>
                        </div>
                    </div>
                    <div class="card-body py-4">
                        <div class="row align-items-center">
                            <div class="col-md-2 text-center text-md-start mb-3 mb-md-0">
                                @if (!string.IsNullOrEmpty(pedido.ProdutoImagemUrl))
                                {
                                    <img src="@pedido.ProdutoImagemUrl" class="img-fluid rounded border" style="max-height: 90px; object-fit: cover;" alt="@pedido.ProdutoNome" />
                                }
                                else
                                {
                                    <div class="bg-light rounded border d-flex align-items-center justify-content-center" style="height: 90px; width: 90px;">
                                        <i class="icon-base ri ri-plant-line fs-2 text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-5 mb-3 mb-md-0">
                                <h5 class="fw-bold mb-1">@pedido.ProdutoNome</h5>
                                <p class="text-muted small mb-1">Vendedor: <strong>@pedido.VendedorNome</strong></p>
                                <p class="text-muted small mb-0">Endereço de Entrega: @pedido.CompradorEndereco</p>
                            </div>
                            <div class="col-md-2 text-md-end mb-3 mb-md-0">
                                <small class="text-muted d-block">Produto: R$ @pedido.ValorPedido.ToString("N2")</small>
                                <small class="text-muted d-block">Frete: R$ @((pedido.ValorFrete ?? 0.00m).ToString("N2"))</small>
                                <strong class="fs-5 text-success d-block mt-1">Total: R$ @pedido.ValorTotal.ToString("N2")</strong>
                            </div>
                            <div class="col-md-3 text-md-end">
                                @if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.AguardandoPagamento && !string.IsNullOrEmpty(pedido.UrlCheckout))
                                {
                                    <a href="@pedido.UrlCheckout" target="_blank" class="btn btn-warning text-dark fw-bold w-100 mb-2">
                                        <i class="icon-base ri ri-bank-card-line me-1"></i> Pagar Agora (Asaas)
                                    </a>
                                }
                                else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.ErroCobranca || (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.AguardandoPagamento && string.IsNullOrEmpty(pedido.UrlCheckout)))
                                {
                                    <span class="badge bg-warning text-dark p-2 d-block text-wrap mb-2">
                                        <i class="icon-base ri ri-time-line me-1"></i> O vendedor aceitou a venda e o link de cobrança está sendo emitido.
                                    </span>
                                }
                                else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.Entregue)
                                {
                                    <form asp-controller="Pedido" asp-action="Conferir" method="post">
                                        <input type="hidden" name="id" value="@pedido.Id" />
                                        <button type="submit" class="btn btn-success fw-bold w-100 mb-2" onclick="return confirm('Confirma que recebeu o pedido em perfeitas condições?');">
                                            <i class="icon-base ri ri-checkbox-circle-line me-1"></i> Conferir e Aceitar Item
                                        </button>
                                    </form>
                                }

                                @if (!string.IsNullOrEmpty(pedido.CodigoRastreio))
                                {
                                    <a href="@(string.IsNullOrEmpty(pedido.UrlRastreio) ? $"https://rastreamento.correios.com.br/app/index.php?codigo={pedido.CodigoRastreio}" : pedido.UrlRastreio)" target="_blank" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="icon-base ri ri-truck-line me-1"></i> Rastrear (@pedido.CodigoRastreio)
                                    </a>
                                }
                            </div>
                        </div>

                        @if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.Recusado && !string.IsNullOrEmpty(pedido.Observacao))
                        {
                            <div class="alert alert-danger mb-0 mt-3 border-0 shadow-sm">
                                <i class="icon-base ri ri-error-warning-line me-1"></i> <strong>Motivo da Recusa pelo Vendedor:</strong> @pedido.Observacao
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

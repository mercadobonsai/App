@model IEnumerable<MercadoBonsai.Domain.Entities.Pedido>
@{
    ViewData["Title"] = "Gerenciar Vendas";
    string? statusFiltro = ViewBag.StatusFiltro as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #4A7C59;">
            <i class="icon-base ri ri-store-line me-2"></i>Gerenciar Vendas
        </h3>
        <p class="text-muted mb-0">Painel do Viveirista para controle do ciclo de entrega dos seus Bonsais e Insumos.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a asp-controller="Produto" asp-action="MeusProdutos" class="btn btn-outline-success">
            <i class="icon-base ri ri-folder-line me-1"></i> Meus Anúncios
        </a>
    </div>
</div>

<!-- Filtros de Status -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="fw-bold text-muted me-2"><i class="icon-base ri ri-filter-3-line me-1"></i>Filtro:</span>
            <a asp-controller="Pedido" asp-action="MinhasVendas" class="btn btn-sm @(string.IsNullOrEmpty(statusFiltro) ? "btn-success" : "btn-outline-secondary")">
                Todos (@Model.Count())
            </a>
            @foreach (var st in MercadoBonsai.Domain.Enums.StatusPedido.Todos)
            {
                <a asp-controller="Pedido" asp-action="MinhasVendas" asp-route-statusFiltro="@st" class="btn btn-sm @(string.Equals(statusFiltro, st, StringComparison.OrdinalIgnoreCase) ? "btn-success" : "btn-outline-secondary")">
                    @st
                </a>
            }
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body py-5">
            <i class="icon-base ri ri-inbox-line fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Nenhuma venda encontrada para este filtro</h5>
            <p class="text-muted mb-0">Novas compras realizadas pelos clientes aparecerão aqui automaticamente.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var pedido in Model)
        {
            string badgeClass = pedido.StatusPedido switch
            {
                "Criado" => "bg-secondary text-white",
                "Aguardando Aceite" => "bg-warning text-white",
                "Recusado" => "bg-danger text-white",
                "Erro na Cobrança" => "bg-danger text-white",
                "Aguardando Pagamento" => "bg-info text-white",
                "Pago" => "bg-success text-white",
                "Em Despacho" => "bg-primary text-white",
                "Em Transito" => "bg-primary text-white",
                "Entregue" => "bg-info text-white",
                "Conferido" => "bg-success text-white",
                "Finalizado" => "bg-dark text-white",
                _ => "bg-secondary text-white"
            };

            // Regra 3: Ocultacao de contato do comprador ate o status 'Pago' ou superior
            bool contatoVisivel = pedido.StatusPedido == "Pago" 
                || pedido.StatusPedido == "Em Despacho" 
                || pedido.StatusPedido == "Em Transito" 
                || pedido.StatusPedido == "Entregue" 
                || pedido.StatusPedido == "Conferido" 
                || pedido.StatusPedido == "Finalizado";

            <div class="col-12 col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100 d-flex flex-column">
                    <!-- Cabeçalho do Card: Número do Pedido, Nome do Comprador e Badge de Status -->
                    <div class="card-header bg-light d-flex align-items-center justify-content-between py-3 border-0">
                        <div>
                            <span class="fw-bold text-dark fs-5">Pedido #@pedido.Numero</span>
                            @if (pedido.LeilaoId.HasValue && pedido.LeilaoId.Value > 0)
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="icon-base ri ri-auction-line me-1"></i>
                                    @(pedido.PosicaoVencedorLeilao == 1 ? "🏆 1º Colocado" : $"🔄 {pedido.PosicaoVencedorLeilao}º Colocado (Chamada Sequencial)")
                                </span>
                            }
                            <small class="text-muted d-block fs-7">Comprador: <strong>@pedido.CompradorNome</strong></small>
                        </div>
                        <div>
                            <span class="badge @badgeClass fs-7 px-3 py-2 fw-semibold">
                                <i class="icon-base ri ri-checkbox-blank-circle-fill me-1 fs-8"></i>@pedido.StatusPedido
                            </span>
                        </div>
                    </div>

                    <!-- Corpo do Card: Foto, Produto, Endereço, Contatos Protegidos e Preço -->
                    <div class="card-body py-3 flex-grow-1">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(pedido.ProdutoImagemUrl))
                            {
                                <img src="@pedido.ProdutoImagemUrl" class="img-fluid rounded border flex-shrink-0" style="width: 75px; height: 75px; object-fit: cover;" alt="@pedido.ProdutoNome" />
                            }
                            else
                            {
                                <div class="bg-light rounded border d-flex align-items-center justify-content-center flex-shrink-0" style="width: 75px; height: 75px;">
                                    <i class="icon-base ri ri-plant-line fs-3 text-muted"></i>
                                </div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="fw-bold text-dark mb-1 text-truncate">@pedido.ProdutoNome</h6>
                                <small class="text-muted d-block mb-1 text-truncate"><i class="icon-base ri ri-map-pin-line me-1"></i>@pedido.CompradorEndereco</small>
                                @if (contatoVisivel)
                                {
                                    <small class="text-success d-block fw-semibold text-truncate">
                                        <i class="icon-base ri ri-phone-line me-1"></i>@pedido.CompradorTelefone | <i class="icon-base ri ri-mail-line me-1"></i>@pedido.CompradorEmail
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted d-block"><i class="icon-base ri ri-lock-line me-1"></i>Contatos liberados pós-pagamento</small>
                                }
                            </div>
                        </div>

                        <!-- Resumo Financeiro -->
                        <div class="bg-light p-2 rounded d-flex justify-content-between align-items-center small">
                            <span class="text-muted">Item: R$ @pedido.ValorPedido.ToString("N2") | Frete: R$ @((pedido.ValorFrete ?? 0.00m).ToString("N2"))</span>
                            <strong class="text-success fs-6">Total: R$ @pedido.ValorTotal.ToString("N2")</strong>
                        </div>

                        @if (!string.IsNullOrEmpty(pedido.CodigoRastreio))
                        {
                            <div class="mt-2 text-muted small">
                                <i class="icon-base ri ri-truck-line me-1"></i>Rastreio: <strong>@pedido.CodigoRastreio</strong>
                            </div>
                        }
                    </div>

                    <!-- Rodapé do Card: Botões de Ação ou Motivo da Recusa em Vermelho -->
                    <div class="card-footer bg-light border-top p-3 mt-auto">
                        @if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.Criado || pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.AguardandoAceite)
                        {
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success btn-sm flex-fill fw-bold" data-bs-toggle="modal" data-bs-target="#modalAceitar_@pedido.Id">
                                    <i class="icon-base ri ri-check-line me-1"></i> Aceitar & Frete
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#modalRecusar_@pedido.Id">
                                    <i class="icon-base ri ri-close-line me-1"></i> Recusar
                                </button>
                            </div>
                        }
                        else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.ErroCobranca || (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.AguardandoPagamento && string.IsNullOrEmpty(pedido.UrlCheckout)))
                        {
                            <form asp-controller="Pedido" asp-action="GerarCobrancaAsaas" method="post">
                                <input type="hidden" name="id" value="@pedido.Id" />
                                <button type="submit" class="btn btn-warning text-dark btn-sm w-100 fw-bold">
                                    <i class="icon-base ri ri-refresh-line me-1"></i> Re-tentar Gerar Cobrança Asaas
                                </button>
                            </form>
                        }
                        else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.Pago)
                        {
                            <form asp-controller="Pedido" asp-action="IniciarDespacho" method="post">
                                <input type="hidden" name="id" value="@pedido.Id" />
                                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                                    <i class="icon-base ri ri-box-3-line me-1"></i> Iniciar Despacho / Embalagem
                                </button>
                            </form>
                        }
                        else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.EmDespacho)
                        {
                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#modalRastreio_@pedido.Id">
                                <i class="icon-base ri ri-truck-line me-1"></i> Informar Rastreio
                            </button>
                        }
                        else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.EmTransito)
                        {
                            <form asp-controller="Pedido" asp-action="ConfirmarEntrega" method="post">
                                <input type="hidden" name="id" value="@pedido.Id" />
                                <button type="submit" class="btn btn-info text-white btn-sm w-100 fw-bold">
                                    <i class="icon-base ri ri-checkbox-circle-line me-1"></i> Confirmar Entrega Realizada
                                </button>
                            </form>
                        }
                        else if (pedido.StatusPedido == MercadoBonsai.Domain.Enums.StatusPedido.Recusado)
                        {
                            <div class="alert alert-danger mb-0 p-2 small border-0 text-start shadow-sm">
                                <i class="icon-base ri ri-error-warning-line me-1"></i> <strong>Motivo da Recusa:</strong> @(string.IsNullOrWhiteSpace(pedido.Observacao) ? "Venda recusada pelo vendedor." : pedido.Observacao)
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted small py-1">
                                <i class="icon-base ri ri-information-line me-1"></i>Aguardando ação do comprador
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Modal Aceitar Pedido -->
            <div class="modal fade" id="modalAceitar_@pedido.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="Pedido" asp-action="AceitarPedido" method="post">
                            <input type="hidden" name="id" value="@pedido.Id" />
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title text-white fw-bold"><i class="icon-base ri ri-check-line me-1"></i> Aceitar Pedido #@pedido.Numero</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p class="text-muted mb-3">Informe o valor real do frete em Reais (BRL) para o envio. O valor será somado ao total da venda e a cobrança será gerada no Asaas.</p>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Valor do Frete (R$ - BRL):</label>
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold bg-light text-dark">R$</span>
                                        <input type="text" name="valorFrete" class="form-control form-control-lg fw-bold text-success" value="@((pedido.ValorFrete ?? 0.00m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" required placeholder="0.00" oninput="limitarDuasCasasDecimais(this)" />
                                    </div>
                                    <small class="text-muted d-block mt-1"><i class="icon-base ri ri-information-line me-1"></i>Preencha com vírgula ou ponto (ex: 55,60). Máximo de 2 casas decimais.</small>
                                </div>

                                <div class="alert alert-info border-0 mb-0">
                                    <i class="icon-base ri ri-shield-check-line me-1"></i> O link de cobrança do Asaas será emitido e enviado ao comprador.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-success fw-bold">Confirmar Aceite & Gerar Cobrança</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Recusar Pedido -->
            <div class="modal fade" id="modalRecusar_@pedido.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="Pedido" asp-action="RecusarPedido" method="post">
                            <input type="hidden" name="id" value="@pedido.Id" />
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title text-white fw-bold"><i class="icon-base ri ri-close-line me-1"></i> Recusar Venda #@pedido.Numero</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Motivo da Recusa (Obrigatório):</label>
                                    <textarea name="observacao" class="form-control" rows="3" placeholder="Ex: Produto fora de estoque no viveiro ou indisponibilidade de entrega para esta região." required></textarea>
                                </div>
                                <div class="alert alert-warning border-0 mb-0 text-dark">
                                    <i class="icon-base ri ri-refresh-line me-1"></i> Ao recusar, o item voltará a ficar disponível automaticamente na vitrine.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-danger fw-bold">Confirmar Recusa</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Informar Rastreio -->
            <div class="modal fade" id="modalRastreio_@pedido.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="Pedido" asp-action="InformarRastreio" method="post">
                            <input type="hidden" name="id" value="@pedido.Id" />
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title text-white fw-bold"><i class="icon-base ri ri-truck-line me-1"></i> Informar Código de Rastreio #@pedido.Numero</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Código de Rastreamento:</label>
                                    <input type="text" name="codigoRastreio" class="form-control" placeholder="Ex: AA123456789BR" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Link Direto de Rastreamento (Opcional):</label>
                                    <input type="url" name="urlRastreio" class="form-control" placeholder="https://..." />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary fw-bold">Salvar & Alterar para 'Em Transito'</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function limitarDuasCasasDecimais(input) {
            if (!input) return;
            let val = input.value;
            // Substitui virgula por ponto
            val = val.replace(',', '.');
            // Mantem apenas numeros e ponto
            val = val.replace(/[^\d.]/g, '');
            
            // Impede mais de um ponto decimal
            let parts = val.split('.');
            if (parts.length > 2) {
                val = parts[0] + '.' + parts.slice(1).join('');
                parts = val.split('.');
            }
            
            // Limita estritamente a no maximo 2 casas decimais
            if (parts[1] && parts[1].length > 2) {
                parts[1] = parts[1].substring(0, 2);
                val = parts.join('.');
            }
            input.value = val;
        }
    </script>
}

@model MercadoBonsai.Web.Models.CriarProdutoViewModel
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Novo Anúncio - Mercado Bonsai";
    int limiteFotos = ViewBag.LimiteFotos as int? ?? 3;
    string planoNome = ViewBag.PlanoNome as string ?? "Bronze";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">🌱 Cadastrar Novo Anúncio</h5>
                        <small class="text-muted">Plano <strong>@planoNome</strong>: até <strong>@limiteFotos fotos</strong> por produto</small>
                    </div>
                    <a asp-controller="Produto" asp-action="MeusProdutos" class="btn btn-sm btn-outline-secondary">
                        <i class="icon-base ri ri-arrow-left-line me-1"></i> Voltar
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Criar" method="post" enctype="multipart/form-data" id="formCriarProduto">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label asp-for="Nome" class="form-label fw-semibold"></label>
                                <input asp-for="Nome" class="form-control" placeholder="Ex: Bonsai Junípero 5 anos" autofocus />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Categoria" class="form-label fw-semibold"></label>
                                <select asp-for="Categoria" class="form-select">
                                    <option value="Pré-bonsai">Pré-bonsai</option>
                                    <option value="Bonsai" selected>Bonsai</option>
                                    <option value="Insumo">Insumo</option>
                                    <option value="Ferramenta">Ferramenta</option>
                                    <option value="Vaso">Vaso</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="Preco" class="form-label fw-semibold">Preço de Venda (R$)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Preco" type="text" class="form-control mask-moeda" placeholder="0,00" data-unmask-on-submit="true" />
                                </div>
                                <span asp-validation-for="Preco" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="PrecoCusto" class="form-label fw-semibold">Preço de Custo (R$)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="PrecoCusto" type="text" class="form-control mask-moeda" placeholder="0,00" data-unmask-on-submit="true" />
                                </div>
                                <span class="text-muted small d-block" style="font-size: 0.75rem;">Visível apenas para você</span>
                                <span asp-validation-for="PrecoCusto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="QuantidadeEstoque" class="form-label fw-semibold"></label>
                                <input asp-for="QuantidadeEstoque" type="number" class="form-control" placeholder="1" />
                                <span asp-validation-for="QuantidadeEstoque" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusProduto>()"></select>
                            </div>
                        </div>

                        <!-- Dimensões Físicas & Peso -->
                        <div class="card bg-light border-0 p-3 mb-4">
                            <h6 class="fw-bold mb-3 text-dark"><i class="icon-base ri ri-ruler-line me-2"></i>Dimensões Físicas & Peso</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="Altura" class="form-label small fw-semibold">Altura (cm)</label>
                                    <input asp-for="Altura" type="number" step="0.1" class="form-control form-control-sm" placeholder="25" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Largura" class="form-label small fw-semibold">Largura (cm)</label>
                                    <input asp-for="Largura" type="number" step="0.1" class="form-control form-control-sm" placeholder="20" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Comprimento" class="form-label small fw-semibold">Comprimento (cm)</label>
                                    <input asp-for="Comprimento" type="number" step="0.1" class="form-control form-control-sm" placeholder="30" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Peso" class="form-label small fw-semibold">Peso (kg)</label>
                                    <input asp-for="Peso" type="number" step="0.1" class="form-control form-control-sm" placeholder="2.5" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FormaEnvio" class="form-label fw-semibold"></label>
                            <select asp-for="FormaEnvio" class="form-select">
                                <option value="Frete incluso">Frete incluso</option>
                                <option value="Frete por conta comprador">Frete por conta comprador</option>
                                <option value="A combinar" selected>A combinar</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descricao" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva os detalhes da planta, idade, cuidados recomendados, etc."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <!-- Galeria de Fotos do Produto (Conforme Limite do Plano) -->
                        <div class="card border shadow-xs p-3 mb-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                <label class="form-label fw-bold mb-0 text-dark">
                                    <i class="icon-base ri ri-image-add-line text-success me-1"></i>Fotos do Produto
                                </label>
                                <span class="badge bg-label-success" id="badgeContadorFotosCriar">
                                    0 / @limiteFotos fotos selecionadas (Plano @planoNome)
                                </span>
                            </div>

                            <input type="file" name="Imagens" id="fotoProdutoInput" class="form-control" accept="image/*" multiple />
                            <div class="form-text">
                                Você pode selecionar até <strong>@limiteFotos fotos</strong> no seu <strong>Plano @planoNome</strong>. A primeira foto será a <strong>Capa Principal</strong> na vitrine.
                                @if (limiteFotos < 12)
                                {
                                    <a href="/Planos" class="text-success fw-semibold ms-1">Aumentar limite de fotos →</a>
                                }
                            </div>
                            <span asp-validation-for="Imagens" class="text-danger small d-block mt-1"></span>
                            <span asp-validation-for="Imagem" class="text-danger small d-block"></span>

                            <div id="alertaLimiteFotosCriar" class="alert alert-warning py-2 px-3 small mt-2 d-none" role="alert"></div>

                            <div id="galeriaPreviewCriar" class="row g-2 mt-2 d-none"></div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="MeusProdutos" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" id="btnSubmitProduto" class="btn btn-success px-4">
                                <i class="icon-base ri ri-save-line me-1"></i> Publicar Anúncio
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/starter-kit/assets/js/masks.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const limiteFotos = @limiteFotos;
            const planoNome = '@planoNome';
            const input = document.getElementById('fotoProdutoInput');
            const galeria = document.getElementById('galeriaPreviewCriar');
            const badgeContador = document.getElementById('badgeContadorFotosCriar');
            const alertaLimite = document.getElementById('alertaLimiteFotosCriar');
            let arquivosAcumulados = [];

            async function normalizarArquivoImagem(file) {
                const isHeic = file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif') || file.type === 'image/heic';
                if (isHeic && typeof heic2any !== 'undefined') {
                    try {
                        const blobResult = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.85 });
                        const singleBlob = Array.isArray(blobResult) ? blobResult[0] : blobResult;
                        file = new File([singleBlob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                    } catch (heicErr) {
                        console.warn('HEIC ignorado:', heicErr);
                    }
                }
                return file;
            }

            function sincronizarInputFiles() {
                const dt = new DataTransfer();
                arquivosAcumulados.forEach(f => dt.items.add(f));
                input.files = dt.files;

                if (badgeContador) {
                    badgeContador.textContent = `${arquivosAcumulados.length} / ${limiteFotos} fotos selecionadas (Plano ${planoNome})`;
                }

                if (!galeria) return;
                galeria.innerHTML = '';

                if (arquivosAcumulados.length === 0) {
                    galeria.classList.add('d-none');
                    return;
                }

                galeria.classList.remove('d-none');
                arquivosAcumulados.forEach((file, idx) => {
                    const url = URL.createObjectURL(file);
                    const col = document.createElement('div');
                    col.className = 'col-6 col-sm-4 col-md-3';
                    col.innerHTML = `
                        <div class="card h-100 border ${idx === 0 ? 'border-success border-2' : ''} shadow-xs position-relative overflow-hidden">
                            <img src="${url}" class="w-100" style="height: 120px; object-fit: cover;" alt="Foto ${idx + 1}" />
                            <span class="badge ${idx === 0 ? 'bg-success' : 'bg-dark bg-opacity-75'} position-absolute top-0 start-0 m-1" style="font-size: 0.65rem;">
                                ${idx === 0 ? '⭐ Capa Principal' : 'Foto #' + (idx + 1)}
                            </span>
                            <div class="card-footer p-1 bg-white d-flex justify-content-between align-items-center">
                                ${idx > 0
                                    ? `<button type="button" class="btn btn-xs btn-outline-success py-0 px-1" style="font-size: 0.7rem;" onclick="definirCapaCriar(${idx})" title="Tornar foto de capa">Definir Capa</button>`
                                    : `<span class="text-success fw-bold small ps-1" style="font-size: 0.7rem;">Capa</span>`}
                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1 ms-auto" onclick="removerFotoCriar(${idx})" title="Remover foto">
                                    <i class="icon-base ri ri-delete-bin-line"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    galeria.appendChild(col);
                });
            }

            window.removerFotoCriar = function (idx) {
                arquivosAcumulados.splice(idx, 1);
                if (alertaLimite) alertaLimite.classList.add('d-none');
                sincronizarInputFiles();
            };

            window.definirCapaCriar = function (idx) {
                if (idx <= 0 || idx >= arquivosAcumulados.length) return;
                const item = arquivosAcumulados.splice(idx, 1)[0];
                arquivosAcumulados.unshift(item);
                sincronizarInputFiles();
            };

            if (input) {
                input.addEventListener('change', async function (e) {
                    const novos = Array.from(e.target.files || []);
                    if (novos.length === 0) {
                        sincronizarInputFiles();
                        return;
                    }

                    let excedeu = false;
                    for (let rawFile of novos) {
                        if (arquivosAcumulados.length >= limiteFotos) {
                            excedeu = true;
                            break;
                        }
                        const file = await normalizarArquivoImagem(rawFile);
                        arquivosAcumulados.push(file);
                    }

                    if (alertaLimite) {
                        if (excedeu) {
                            alertaLimite.innerHTML = `<i class="icon-base ri ri-information-line me-1"></i>Seu <strong>Plano ${planoNome}</strong> permite no máximo <strong>${limiteFotos} fotos</strong> por produto. As fotos excedentes não foram adicionadas.`;
                            alertaLimite.classList.remove('d-none');
                        } else {
                            alertaLimite.classList.add('d-none');
                        }
                    }

                    sincronizarInputFiles();
                });
            }

            const btn = document.getElementById('btnSubmitProduto');
            const form = document.getElementById('formCriarProduto');
            if (btn && form) {
                form.addEventListener('submit', function () {
                    sincronizarInputFiles();
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Publicando produto...';
                });
            }
        });
    </script>
}

@model MercadoBonsai.Web.Models.CriarProdutoViewModel
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Novo Anúncio - Mercado Bonsai";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-dark">🌱 Cadastrar Novo Anúncio</h5>
                    <a asp-controller="Produto" asp-action="MeusProdutos" class="btn btn-sm btn-outline-secondary">
                        <i class="icon-base ri ri-arrow-left-line me-1"></i> Voltar
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Criar" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label asp-for="Nome" class="form-label fw-semibold"></label>
                                <input asp-for="Nome" class="form-control" placeholder="Ex: Bonsai Junípero 5 anos" autofocus />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Categoria" class="form-label fw-semibold"></label>
                                <select asp-for="Categoria" class="form-select">
                                    <option value="Pré-bonsai">Pré-bonsai</option>
                                    <option value="Bonsai" selected>Bonsai</option>
                                    <option value="Insumo">Insumo</option>
                                    <option value="Ferramenta">Ferramenta</option>
                                    <option value="Vaso">Vaso</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Preco" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="Preco" type="text" class="form-control mask-moeda" placeholder="0,00" data-unmask-on-submit="true" />
                                </div>
                                <span asp-validation-for="Preco" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="QuantidadeEstoque" class="form-label fw-semibold"></label>
                                <input asp-for="QuantidadeEstoque" type="number" class="form-control" placeholder="1" />
                                <span asp-validation-for="QuantidadeEstoque" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusProduto>()"></select>
                            </div>
                        </div>

                        <!-- Dimensões Físicas & Peso -->
                        <div class="card bg-light border-0 p-3 mb-4">
                            <h6 class="fw-bold mb-3 text-dark"><i class="icon-base ri ri-ruler-line me-2"></i>Dimensões Físicas & Peso</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="Altura" class="form-label small fw-semibold">Altura (cm)</label>
                                    <input asp-for="Altura" type="number" step="0.1" class="form-control form-control-sm" placeholder="25" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Largura" class="form-label small fw-semibold">Largura (cm)</label>
                                    <input asp-for="Largura" type="number" step="0.1" class="form-control form-control-sm" placeholder="20" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Comprimento" class="form-label small fw-semibold">Comprimento (cm)</label>
                                    <input asp-for="Comprimento" type="number" step="0.1" class="form-control form-control-sm" placeholder="30" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Peso" class="form-label small fw-semibold">Peso (kg)</label>
                                    <input asp-for="Peso" type="number" step="0.1" class="form-control form-control-sm" placeholder="2.5" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FormaEnvio" class="form-label fw-semibold"></label>
                            <select asp-for="FormaEnvio" class="form-select">
                                <option value="Frete incluso">Frete incluso</option>
                                <option value="Frete por conta comprador">Frete por conta comprador</option>
                                <option value="A combinar" selected>A combinar</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descricao" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva os detalhes da planta, idade, cuidados recomendados, etc."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Imagem" class="form-label fw-semibold"></label>
                            <input asp-for="Imagem" type="file" id="fotoProdutoInput" class="form-control" accept="image/*" />
                            <div class="form-text">Envie uma foto nítida do seu produto (otimizada automaticamente antes do envio).</div>
                            <span asp-validation-for="Imagem" class="text-danger small"></span>
                            <div id="previewProdutoContainer" class="mt-2 d-none">
                                <img id="imgPreviewProduto" src="" class="img-fluid rounded border shadow-sm" style="max-height: 180px; object-fit: cover;" alt="Prévia da Foto" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="MeusProdutos" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" id="btnSubmitProduto" class="btn btn-success px-4">
                                <i class="icon-base ri ri-save-line me-1"></i> Publicar Anúncio
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/starter-kit/assets/js/masks.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('fotoProdutoInput');
            const preview = document.getElementById('imgPreviewProduto');
            const container = document.getElementById('previewProdutoContainer');
            if (input) {
                input.addEventListener('change', async function (e) {
                    let file = e.target.files[0];
                    if (!file) {
                        if (container) container.classList.add('d-none');
                        return;
                    }

                    const isHeic = file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif') || file.type === 'image/heic';
                    if (isHeic && typeof heic2any !== 'undefined') {
                        try {
                            const blobResult = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.85 });
                            const singleBlob = Array.isArray(blobResult) ? blobResult[0] : blobResult;
                            file = new File([singleBlob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                            const dt = new DataTransfer();
                            dt.items.add(file);
                            input.files = dt.files;
                        } catch (heicErr) {
                            console.warn('HEIC ignorado:', heicErr);
                        }
                    }

                    if (!file.type.startsWith('image/')) return;
                    if (preview && container) {
                        preview.src = URL.createObjectURL(file);
                        container.classList.remove('d-none');
                    }

                    if (file.size > 800 * 1024) {
                        try {
                            const img = new Image();
                            img.src = URL.createObjectURL(file);
                            await img.decode();
                            const maxDim = 1600;
                            let width = img.width, height = img.height;
                            if (width > maxDim || height > maxDim) {
                                if (width > height) { height = Math.round((height * maxDim) / width); width = maxDim; }
                                else { width = Math.round((width * maxDim) / height); height = maxDim; }
                            }
                            const canvas = document.createElement('canvas');
                            canvas.width = width; canvas.height = height;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);
                            canvas.toBlob(function (blob) {
                                if (blob && blob.size < file.size) {
                                    const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                                    const dt = new DataTransfer();
                                    dt.items.add(newFile);
                                    input.files = dt.files;
                                    if (preview) preview.src = URL.createObjectURL(newFile);
                                }
                            }, 'image/jpeg', 0.85);
                        } catch (err) {
                            console.warn('Compressão ignorada:', err);
                        }
                    }
                });
            }

            const btn = document.getElementById('btnSubmitProduto');
            if (btn && input && input.form) {
                input.form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Publicando produto...';
                });
            }
        });
    </script>
}

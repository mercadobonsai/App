@model MercadoBonsai.Domain.Entities.Produto
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = $"{Model.Nome} - Mercado Bonsai";
    var isIndisponivel = Model.Status == StatusProduto.Indisponivel;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a asp-controller="Produto" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="icon-base ri ri-arrow-left-line me-1"></i> Voltar para a Vitrine
        </a>
        <span class="badge bg-label-info fs-6">Categoria: @Model.Categoria</span>
    </div>

    <div class="card shadow-sm overflow-hidden border-0">
        <div class="row g-0">
            <!-- Coluna de Imagens / Capa -->
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center p-4">
                @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                {
                    <img src="@Model.ImagemUrl" class="img-fluid rounded shadow-sm" alt="@Model.Nome" style="max-height: 440px; width: 100%; object-fit: contain;" />
                }
                else
                {
                    <div class="text-center p-5 text-muted">
                        <i class="icon-base ri ri-image-line" style="font-size: 5rem;"></i>
                        <p class="mt-2">Nenhuma foto de capa cadastrada</p>
                    </div>
                }
            </div>

            <!-- Coluna de Informações do Anúncio -->
            <div class="col-md-6 p-4 p-lg-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        @if (isIndisponivel)
                        {
                            <span class="badge bg-secondary">Indisponível / Em Transação</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Disponível em Estoque</span>
                        }
                        <small class="text-muted">Anunciado em @Model.DataCriacao.ToString("dd/MM/yyyy")</small>
                    </div>

                    <h2 class="fw-bold mb-2 text-dark">@Model.Nome</h2>
                    <h3 class="fw-bold mb-4 @(isIndisponivel ? "text-muted" : "text-success")">R$ @Model.Preco.ToString("N2")</h3>

                    <!-- Especificações Físicas & Medidas (2 casas decimais para Altura/Largura/Comprimento e 3 para Peso) -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <h6 class="fw-bold mb-3 text-dark d-flex align-items-center">
                            <i class="icon-base ri ri-ruler-line text-success me-2 fs-5"></i>Especificações Físicas & Dimensões
                        </h6>
                        <div class="row g-3">
                            <div class="col-6 col-sm-3 text-center border-end">
                                <small class="text-muted d-block">Altura</small>
                                <strong class="text-dark">@(Model.Altura > 0 ? $"{Model.Altura:N2} cm" : "N/I")</strong>
                            </div>
                            <div class="col-6 col-sm-3 text-center border-end">
                                <small class="text-muted d-block">Largura</small>
                                <strong class="text-dark">@(Model.Largura > 0 ? $"{Model.Largura:N2} cm" : "N/I")</strong>
                            </div>
                            <div class="col-6 col-sm-3 text-center border-end">
                                <small class="text-muted d-block">Comprimento</small>
                                <strong class="text-dark">@(Model.Comprimento > 0 ? $"{Model.Comprimento:N2} cm" : "N/I")</strong>
                            </div>
                            <div class="col-6 col-sm-3 text-center">
                                <small class="text-muted d-block">Peso (kg)</small>
                                <strong class="text-dark">@(Model.Peso > 0 ? $"{Model.Peso:N3} kg" : "N/I")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Forma de Envio -->
                    <div class="p-3 bg-label-success rounded mb-4 d-flex align-items-center">
                        <i class="icon-base ri ri-truck-line text-success fs-3 me-3"></i>
                        <div>
                            <small class="text-muted d-block">Forma de Envio Combinada:</small>
                            <strong class="text-success fs-6">@(string.IsNullOrWhiteSpace(Model.FormaEnvio) ? "Frete por conta do comprador" : Model.FormaEnvio)</strong>
                        </div>
                    </div>

                    <!-- Descrição -->
                    <div class="mb-4">
                        <h6 class="fw-semibold text-uppercase text-muted small">Descrição do Anúncio</h6>
                        <p class="card-text text-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Sem descrição detalhada." : Model.Descricao)</p>
                    </div>
                </div>

                <div>
                    @if (isIndisponivel)
                    {
                        <button class="btn btn-secondary btn-lg w-100 disabled" disabled>
                            <i class="icon-base ri ri-lock-line me-2"></i> Produto Indisponível para Compra
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success btn-lg w-100 shadow-sm" onclick="alert('Funcionalidade de compra em breve!')">
                            <i class="icon-base ri ri-shopping-cart-2-line me-2"></i> Comprar Agora (Estoque: @Model.QuantidadeEstoque)
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

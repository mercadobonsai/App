@model IEnumerable<MercadoBonsai.Domain.Entities.Produto>
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Catálogo Completo de Bonsais - Mercado Bonsai";
    var busca = ViewData["Busca"] as string;
    var ordem = ViewData["Ordem"] as string;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Header e Título da Vitrine -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: #4A7C59;">🌱 Catálogo Completo & Vitrine de Busca</h3>
            <p class="text-muted mb-0">Navegue, pesquise e encontre os melhores exemplares de bonsais</p>
        </div>
        @if (User.IsInRole("Vendedor") || User.IsInRole("Administrador"))
        {
            <a asp-controller="Produto" asp-action="Criar" class="btn btn-success">
                <i class="icon-base ri ri-add-line me-1"></i> Anunciar Bonsai
            </a>
        }
    </div>

    <!-- Barra de Filtros e Pesquisa -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-6 col-lg-7">
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="icon-base ri ri-search-line"></i></span>
                        <input type="text" name="busca" value="@busca" class="form-control" placeholder="Buscar por nome do bonsai ou descrição..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select name="ordem" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(ordem))">Ordenar por: Mais Recentes</option>
                        <option value="preco_asc" selected="@(ordem == "preco_asc")">Menor Preço</option>
                        <option value="preco_desc" selected="@(ordem == "preco_desc")">Maior Preço</option>
                        <option value="nome" selected="@(ordem == "nome")">Nome (A-Z)</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">Filtrar</button>
                    @if (!string.IsNullOrEmpty(busca) || !string.IsNullOrEmpty(ordem))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpar Filtros">
                            <i class="icon-base ri ri-close-line"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Badges de Resultado -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted small">Exibindo <strong>@Model.Count()</strong> produto(s) no catálogo</span>
        @if (!string.IsNullOrEmpty(busca))
        {
            <span class="badge bg-label-success">Resultados para: "@busca"</span>
        }
    </div>

    <!-- Grid de Produtos -->
    @if (!Model.Any())
    {
        <div class="card text-center p-5 border-0 shadow-sm">
            <div class="card-body">
                <i class="icon-base ri ri-leaf-line text-muted" style="font-size: 4rem;"></i>
                <h5 class="mt-3 fw-bold">Nenhum bonsai encontrado</h5>
                <p class="text-muted">Tente buscar por outros termos ou remova os filtros aplicados.</p>
                <a asp-action="Index" class="btn btn-outline-success mt-2">Ver Todos os Produtos</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                var isIndisponivel = p.Status == StatusProduto.Indisponivel;
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 hover-top transition overflow-hidden" style="@(isIndisponivel ? "opacity: 0.65; filter: grayscale(30%);" : "")">
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(p.ImagemUrl))
                            {
                                <img src="@p.ImagemUrl" class="card-img-top" alt="@p.Nome" style="height: 220px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center card-img-top" style="height: 220px;">
                                    <i class="icon-base ri ri-image-line text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                            @if (isIndisponivel)
                            {
                                <span class="badge bg-secondary position-absolute top-0 end-0 m-3 shadow-sm">Indisponível / Em Transação</span>
                            }
                            else
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 shadow-sm">Disponível</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold mb-2">@p.Nome</h5>
                                <p class="card-text text-muted text-truncate-2 mb-3">@(string.IsNullOrWhiteSpace(p.Descricao) ? "Exemplar selecionado de bonsai." : p.Descricao)</p>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-4 fw-bold @(isIndisponivel ? "text-muted" : "text-success")">R$ @p.Preco.ToString("N2")</span>
                                    <small class="text-muted"><i class="icon-base ri ri-stack-line me-1"></i>Estoque: @p.QuantidadeEstoque</small>
                                </div>
                                <a asp-controller="Produto" asp-action="Detalhes" asp-route-id="@p.Id" class="btn @(isIndisponivel ? "btn-outline-secondary" : "btn-outline-success") w-100">
                                    <i class="icon-base ri ri-eye-line me-1"></i> Ver Detalhes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

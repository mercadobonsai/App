@model IEnumerable<MercadoBonsai.Domain.Entities.Produto>
@using MercadoBonsai.Domain.Enums
@{
    ViewData["Title"] = "Meus Anúncios - Mercado Bonsai";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: #4A7C59;">📋 Meus Anúncios de Bonsai</h4>
            <p class="text-muted mb-0">Gerencie suas ofertas, edite informações, acompanhe estoque e o histórico de vendas</p>
        </div>
        <a asp-controller="Produto" asp-action="Criar" class="btn btn-success">
            <i class="icon-base ri ri-add-line me-1"></i> Novo Anúncio
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Imagem</th>
                        <th>Bonsai / Produto</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Status</th>
                        <th>Data de Cadastro</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="icon-base ri ri-inbox-line me-1 fs-4 align-middle"></i>
                                Você ainda não possui nenhum produto cadastrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagemUrl))
                                    {
                                        <img src="@item.ImagemUrl" alt="@item.Nome" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="icon-base ri ri-image-line text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong class="d-block text-heading">@item.Nome</strong>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;">@item.Descricao</small>
                                </td>
                                <td>
                                    <span class="fw-semibold text-success">R$ @item.Preco.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="badge bg-label-success">@item.QuantidadeEstoque un.</span>
                                </td>
                                <td>
                                    @if (item.Status == StatusProduto.Vendido)
                                    {
                                        <span class="badge bg-danger">Vendido</span>
                                    }
                                    else if (item.Status == StatusProduto.Indisponivel)
                                    {
                                        <span class="badge bg-secondary">Indisponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Disponível</span>
                                    }
                                </td>
                                <td>@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success me-1" title="Editar Anúncio">
                                        <i class="icon-base ri ri-edit-box-line me-1"></i> Editar
                                    </a>
                                    <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-label-secondary" title="Ver Detalhes">
                                        <i class="icon-base ri ri-eye-line"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model MercadoBonsai.Domain.Entities.ProntuarioPlanta
@{
    ViewData["Title"] = $"Prontuário - {Model.NomePopular}";
    bool modoDemonstracao = (bool)(ViewData["ModoDemonstracao"] ?? false);
    bool somenteLeitura = (bool)(ViewData["SomenteLeitura"] ?? false);
    string lockMensagem = (string)(ViewData["LockMensagem"] ?? string.Empty);
    bool planoPago = (bool)(ViewData["PlanoPago"] ?? false);
    var eventos = ViewData["Eventos"] as IEnumerable<MercadoBonsai.Domain.Entities.ProntuarioEvento> ?? new List<MercadoBonsai.Domain.Entities.ProntuarioEvento>();
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <a asp-controller="Prontuario" asp-action="Index" class="text-success text-decoration-none small mb-2 d-inline-block">
            <i class="icon-base ri ri-arrow-left-line me-1"></i> Voltar ao Prontuário
        </a>
        <h4 class="fw-bold mb-1" style="color: #4A7C59;">@Model.NomePopular</h4>
        <p class="text-muted mb-0">@(string.IsNullOrEmpty(Model.NomeCientifico) ? Model.Especie : Model.NomeCientifico) • Registrada em @Model.DataInicial.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex flex-wrap justify-content-md-end gap-2">
        <a asp-controller="Prontuario" asp-action="VenderPlanta" asp-route-id="@Model.Id" class="btn btn-success shadow-sm">
            <i class="icon-base ri ri-store-2-line me-1"></i> Vender Esta Planta
        </a>
        @if (!somenteLeitura && !modoDemonstracao)
        {
            <a asp-controller="Prontuario" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-primary shadow-sm">
                <i class="icon-base ri ri-edit-box-line me-1"></i> Editar Planta
            </a>
            <button type="button" class="btn btn-outline-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoEvento">
                <i class="icon-base ri ri-add-line me-1"></i> Nova Ação
            </button>
        }
        else if (somenteLeitura)
        {
            <button type="button" class="btn btn-secondary shadow-sm" disabled title="Edição bloqueada por concorrência">
                <i class="icon-base ri ri-lock-line me-1"></i> Somente Leitura
            </button>
        }
    </div>
</div>

@if (somenteLeitura)
{
    <div class="alert alert-warning border-0 shadow-sm p-3 mb-4 d-flex align-items-center">
        <i class="icon-base ri ri-lock-2-line fs-3 me-3 text-warning"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Aviso de Edição Simultânea (Concorrência Ativa)</h6>
            <span class="small text-dark">@lockMensagem</span>
        </div>
    </div>
}
else if (modoDemonstracao)
{
    <div class="alert alert-warning border-0 shadow-sm p-3 mb-4 d-flex align-items-center">
        <i class="icon-base ri ri-alert-line fs-3 me-3 text-warning"></i>
        <div>
            <h6 class="fw-bold mb-1 text-dark">Visualização de Exemplo Fictício</h6>
            <span class="small text-dark">
                Esta tela demonstra a linha do tempo completa do bonsai. O salvamento de alterações e novos eventos está bloqueado neste exemplo.
            </span>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Coluna Esquerda: Ficha Técnica da Planta -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="overflow-hidden bg-light position-relative rounded-top d-flex align-items-center justify-content-center" style="height: 320px; cursor: pointer;" onclick="ampliarFoto('@(string.IsNullOrEmpty(Model.FotoPrincipalUrl) ? "https://cdn.mercadobonsai.com.br/padrao/shimpaku_leilao.webp" : Model.FotoPrincipalUrl)', '@Model.NomePopular', 'Foto Oficial da Planta')">
                <img src="@(string.IsNullOrEmpty(Model.FotoPrincipalUrl) ? "https://cdn.mercadobonsai.com.br/padrao/shimpaku_leilao.webp" : Model.FotoPrincipalUrl)" 
                     onerror="this.onerror=null;this.src='https://cdn.mercadobonsai.com.br/padrao/shimpaku_leilao.webp';" 
                     class="w-100 h-100" 
                     style="object-fit: cover;" 
                     alt="@Model.NomePopular" />
                <span class="badge bg-success position-absolute top-0 end-0 m-3 px-3 py-2 shadow-sm">
                    @Model.Especie
                </span>
                @if (!somenteLeitura && !modoDemonstracao)
                {
                    <a asp-controller="Prontuario" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-xs btn-light position-absolute top-0 start-0 m-3 shadow-xs" onclick="event.stopPropagation();" title="Editar dados e foto da planta">
                        <i class="icon-base ri ri-camera-switch-line me-1"></i>Alterar Foto
                    </a>
                }
                <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 small">
                    <i class="icon-base ri ri-zoom-in-line me-1"></i>Clique para ampliar
                </span>
            </div>
            <div class="card-body p-4">
                <h5 class="fw-bold text-success mb-3">Ficha Técnica de Cultivo</h5>
                
                <div class="bg-light p-3 rounded mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Altura:</span>
                        <strong>@Model.Altura.ToString("N2") cm</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Largura:</span>
                        <strong>@Model.Largura.ToString("N2") cm</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Comprimento:</span>
                        <strong>@Model.Comprimento.ToString("N2") cm</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Peso do Conjunto:</span>
                        <strong>@Model.Peso.ToString("N3") kg</strong>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2">Calendário de Cuidados</h6>
                <ul class="list-group list-group-flush mb-3 small">
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Última Manutenção:</span>
                        <span class="badge bg-label-success">@(Model.DataUltimaManutencao?.ToString("dd/MM/yyyy") ?? "Pendente")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Próxima Manutenção:</span>
                        <span class="badge bg-label-info">@(Model.DataProximaManutencao?.ToString("dd/MM/yyyy") ?? "Não agendada")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Última Adubação:</span>
                        <span class="badge bg-label-warning text-dark">@(Model.DataUltimaAdubacao?.ToString("dd/MM/yyyy") ?? "Pendente")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Próxima Adubação:</span>
                        <span class="badge bg-label-primary">@(Model.DataProximaAdubacao?.ToString("dd/MM/yyyy") ?? "Não agendada")</span>
                    </li>
                </ul>

                <h6 class="fw-bold text-dark mb-1">Notas do Cultivador</h6>
                <p class="text-muted small mb-0">
                    @(string.IsNullOrWhiteSpace(Model.DescricaoLivre) ? "Nenhuma observação registrada." : Model.DescricaoLivre)
                </p>
            </div>
        </div>
    </div>

    <!-- Coluna Direita: Feed / Timeline de Manutenções -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-success mb-1"><i class="icon-base ri ri-history-line me-2"></i>Linha do Tempo & Histórico</h5>
                    <small class="text-muted">Manutenções, adubações e evoluções registradas</small>
                </div>
                @if (!somenteLeitura)
                {
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalNovoEvento">
                        <i class="icon-base ri ri-add-line me-1"></i> Nova Ação
                    </button>
                }
            </div>
            <div class="card-body p-4">
                @if (!eventos.Any())
                {
                    <div class="text-center py-5">
                        <i class="icon-base ri ri-calendar-todo-line fs-1 text-muted d-block mb-3"></i>
                        <h6 class="fw-bold text-dark">Nenhum evento registrado ainda</h6>
                        <p class="text-muted small mb-3">Comece a registrar o histórico de podas, adubações e transplantes do seu bonsai!</p>
                        @if (!somenteLeitura)
                        {
                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNovoEvento">
                                Registrar Primeira Ação
                            </button>
                        }
                    </div>
                }
                else
                {
                    <!-- REQUIREMENT 2: Ajuste de Espaçamento com respiro visual amplo na Timeline -->
                    <div class="timeline position-relative border-start border-3 border-success ms-4 ps-4 ps-md-5 my-3">
                        @foreach (var ev in eventos)
                        {
                            <div class="mb-4 position-relative">
                                <!-- Ícone de Check posicionado perfeitamente sobre a linha vertical -->
                                <div class="position-absolute rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; left: -41px; top: 10px; z-index: 2;">
                                    <i class="icon-base ri ri-check-line fs-6"></i>
                                </div>
                                
                                <!-- Card do Evento com margem lateral ms-3 para amplo respiro visual -->
                                <div class="card border border-light shadow-sm bg-light p-3 p-md-4 rounded ms-3 ms-md-4">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-2 gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <h6 class="fw-bold text-success mb-0 fs-6">@ev.Titulo</h6>
                                            <span class="badge bg-white text-dark border shadow-xs px-2 py-1 small">
                                                <i class="icon-base ri ri-calendar-line text-success me-1"></i> @ev.DataEvento.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                        @if (!somenteLeitura && !modoDemonstracao)
                                        {
                                            <div class="d-flex gap-1">
                                                <button type="button" class="btn btn-xs btn-outline-primary shadow-xs" title="Editar Ação" onclick='abrirModalEditarEvento(@ev.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.Titulo)), "@ev.DataEvento.ToString("yyyy-MM-dd")", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.Descricao)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.NomeAdubo ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.NomeRemedio ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.FotoUrl ?? "")))'>
                                                    <i class="icon-base ri ri-edit-line me-1"></i>Editar
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-danger shadow-xs" title="Excluir Ação" onclick='abrirModalExcluirEvento(@ev.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ev.Titulo)))'>
                                                    <i class="icon-base ri ri-delete-bin-line me-1"></i>Excluir
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <p class="text-dark small mb-3" style="white-space: pre-line;">@ev.Descricao</p>

                                    <!-- Badges destacados de Adubo e Defensivo/Remédio -->
                                    @if (!string.IsNullOrEmpty(ev.NomeAdubo) || !string.IsNullOrEmpty(ev.NomeRemedio))
                                    {
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @if (!string.IsNullOrEmpty(ev.NomeAdubo))
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2 fs-7 shadow-xs">
                                                    <i class="icon-base ri ri-leaf-line me-1"></i> <strong>Adubo:</strong> @ev.NomeAdubo
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(ev.NomeRemedio))
                                            {
                                                <span class="badge bg-info text-white px-3 py-2 fs-7 shadow-xs">
                                                    <i class="icon-base ri ri-capsule-line me-1"></i> <strong>Defensivo / Remédio:</strong> @ev.NomeRemedio
                                                </span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(ev.FotoUrl))
                                    {
                                        <div class="mt-2 rounded overflow-hidden shadow-xs border position-relative" style="max-width: 380px; height: 220px; cursor: pointer;" onclick="ampliarFoto('@ev.FotoUrl', '@ev.Titulo', '@ev.DataEvento.ToString("dd/MM/yyyy")')">
                                            <img src="@ev.FotoUrl" 
                                                 onerror="this.onerror=null;this.src='https://cdn.mercadobonsai.com.br/padrao/shimpaku_detalhe.webp';" 
                                                 class="w-100 h-100" 
                                                 style="object-fit: cover;" 
                                                 alt="Foto do evento" />
                                            <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 small">
                                                <i class="icon-base ri ri-zoom-in-line me-1"></i>Ampliar Foto
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- REQUIREMENT 1: Modal de Ação / Evento com Campos de Adubo e Defensivo -->
@if (!somenteLeitura)
{
    <div class="modal fade" id="modalNovoEvento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold text-white"><i class="icon-base ri ri-add-circle-line me-2"></i>Registrar Nova Ação / Manutenção</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Prontuario" asp-action="AdicionarEvento" method="post" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <input type="hidden" name="plantaId" value="@Model.Id" />
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold text-dark">Título da Ação / Evento *</label>
                                <input type="text" name="titulo" class="form-control" placeholder="Ex: Poda de Seleção, Transplante, Adubação..." required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-dark">Data da Realização *</label>
                                <input type="date" name="dataEvento" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Descrição / Observações *</label>
                            <textarea name="descricao" class="form-control" rows="3" placeholder="Detalhes da intervenção realizada no bonsai..." required></textarea>
                        </div>

                        <!-- Inclusão dos Campos de Adubo e Defensivo no Formulário de Ação -->
                        <div class="p-3 bg-light rounded border mb-3">
                            <h6 class="fw-bold text-success mb-3 d-flex align-items-center">
                                <i class="icon-base ri ri-flask-line me-2 fs-5"></i> Insumos & Tratamentos Aplicados
                            </h6>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-leaf-line text-warning me-1"></i> Nome do Adubo Utilizado (Opcional)
                                    </label>
                                    <input type="text" name="nomeAdubo" class="form-control" placeholder="Ex: Osmocote 15-9-12, Hanagokoro, Bokashi Orgânico" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-capsule-line text-info me-1"></i> Nome do Defensivo / Remédio Aplicado (Opcional)
                                    </label>
                                    <input type="text" name="nomeRemedio" class="form-control" placeholder="Ex: Calda Sulfocálcica, Óleo de Neem, Manzate" />
                                </div>
                            </div>

                            @if (planoPago)
                            {
                                <div>
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-image-add-line text-success me-1"></i> Anexar 1 Foto do Evento (Plano Pago Liberado)
                                    </label>
                                    <input type="file" name="fotoEvento" class="form-control" accept="image/*" />
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary small mb-0 p-2">
                                    <i class="icon-base ri ri-lock-line me-1"></i>
                                    O anexo de foto do evento é um recurso exclusivo dos <strong>Planos Pagos (Bronze, Prata e Ouro)</strong>.
                                    <a asp-controller="Conta" asp-action="Assinatura" class="fw-bold text-success text-decoration-underline ms-1">Assinar Plano</a>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" @(modoDemonstracao ? "disabled" : "")>
                            <i class="icon-base ri ri-save-line me-1"></i> Salvar Ação
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Edição de Evento / Ação -->
    <div class="modal fade" id="modalEditarEvento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold text-white"><i class="icon-base ri ri-edit-line me-2"></i>Editar Ação / Manutenção</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Prontuario" asp-action="EditarEvento" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editEventoId" />
                    <input type="hidden" name="plantaId" value="@Model.Id" />

                    <div class="modal-body p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold text-dark">Título da Ação / Evento *</label>
                                <input type="text" name="titulo" id="editEventoTitulo" class="form-control" placeholder="Ex: Poda de Seleção, Transplante, Adubação..." required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-dark">Data da Realização *</label>
                                <input type="date" name="dataEvento" id="editEventoData" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Descrição / Observações *</label>
                            <textarea name="descricao" id="editEventoDescricao" class="form-control" rows="3" placeholder="Detalhes da intervenção realizada..." required></textarea>
                        </div>

                        <div class="p-3 bg-light rounded border mb-3">
                            <h6 class="fw-bold text-success mb-3 d-flex align-items-center">
                                <i class="icon-base ri ri-flask-line me-2 fs-5"></i> Insumos & Tratamentos Aplicados
                            </h6>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-leaf-line text-warning me-1"></i> Nome do Adubo Utilizado (Opcional)
                                    </label>
                                    <input type="text" name="nomeAdubo" id="editEventoAdubo" class="form-control" placeholder="Ex: Osmocote 15-9-12, Hanagokoro, Bokashi Orgânico" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-capsule-line text-info me-1"></i> Nome do Defensivo / Remédio Aplicado (Opcional)
                                    </label>
                                    <input type="text" name="nomeRemedio" id="editEventoRemedio" class="form-control" placeholder="Ex: Calda Sulfocálcica, Óleo de Neem, Manzate" />
                                </div>
                            </div>

                            @if (planoPago)
                            {
                                <div>
                                    <label class="form-label small fw-semibold text-dark">
                                        <i class="icon-base ri ri-image-edit-line text-success me-1"></i> Foto do Evento (Substituir ou Remover)
                                    </label>
                                    <div id="editEventoFotoAtualContainer" class="d-none mb-2 p-2 bg-white rounded border d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <img id="editEventoFotoAtualImg" src="" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="Foto atual" />
                                            <small class="text-muted">Foto atualmente vinculada a esta ação</small>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" name="removerFoto" value="true" id="editEventoRemoverFoto">
                                            <label class="form-check-label text-danger small fw-semibold" for="editEventoRemoverFoto">Remover Foto</label>
                                        </div>
                                    </div>
                                    <input type="file" name="novaFotoEvento" id="editEventoNovaFotoInput" class="form-control" accept="image/*" />
                                    <small class="text-muted">Selecione uma nova imagem para substituir a foto existente desta ação.</small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="icon-base ri ri-save-line me-1"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de Confirmação de Exclusão de Ação -->
    <div class="modal fade" id="modalExcluirEvento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold text-white"><i class="icon-base ri ri-alert-line me-2"></i>Confirmar Exclusão de Ação</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Prontuario" asp-action="ExcluirEvento" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteEventoId" />
                    <input type="hidden" name="plantaId" value="@Model.Id" />

                    <div class="modal-body p-4 text-center">
                        <i class="icon-base ri ri-delete-bin-2-line fs-1 text-danger d-block mb-3"></i>
                        <h6 class="fw-bold text-dark mb-2">Deseja realmente excluir esta ação do histórico?</h6>
                        <p class="text-muted small mb-0">
                            A ação <strong id="deleteEventoTitulo" class="text-dark"></strong> será removida permanentemente da linha do tempo. Esta operação não pode ser desfeita.
                        </p>
                    </div>
                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="icon-base ri ri-delete-bin-line me-1"></i> Sim, Excluir Ação
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal de Visualização Ampliada de Foto (Padrão CDN Cloudflare R2) -->
<div class="modal fade" id="modalFotoAmpliada" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2 px-3">
                <div>
                    <h6 class="modal-title fw-bold text-white mb-0" id="modalFotoTitulo">Visualização da Imagem</h6>
                    <small class="text-white-50" id="modalFotoSubtitulo"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2 text-center bg-dark d-flex align-items-center justify-content-center" style="min-height: 400px;">
                <img id="modalFotoImg" src="" class="img-fluid rounded shadow-sm" style="max-height: 75vh; object-fit: contain;" alt="Foto ampliada" />
            </div>
            <div class="modal-footer bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                <small class="text-muted"><i class="icon-base ri ri-cloud-line text-success me-1"></i>Hospedado via CDN Cloudflare R2</small>
                <a id="modalFotoLinkDireto" href="#" target="_blank" class="btn btn-sm btn-outline-success">
                    <i class="icon-base ri ri-external-link-line me-1"></i>Abrir em Alta Resolução
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
    <script>
        function ampliarFoto(url, titulo, subtitulo) {
            if (!url) return;
            document.getElementById('modalFotoImg').src = url;
            document.getElementById('modalFotoTitulo').innerText = titulo || 'Visualização da Foto';
            document.getElementById('modalFotoSubtitulo').innerText = subtitulo || '';
            document.getElementById('modalFotoLinkDireto').href = url;
            var modalEl = document.getElementById('modalFotoAmpliada');
            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }

        function abrirModalEditarEvento(id, titulo, dataEvento, descricao, adubo, remedio, fotoUrl) {
            document.getElementById('editEventoId').value = id;
            document.getElementById('editEventoTitulo').value = titulo;
            document.getElementById('editEventoData').value = dataEvento;
            document.getElementById('editEventoDescricao').value = descricao;
            document.getElementById('editEventoAdubo').value = adubo || '';
            document.getElementById('editEventoRemedio').value = remedio || '';

            const fotoContainer = document.getElementById('editEventoFotoAtualContainer');
            const fotoImg = document.getElementById('editEventoFotoAtualImg');
            const removerFotoCheck = document.getElementById('editEventoRemoverFoto');
            if (removerFotoCheck) removerFotoCheck.checked = false;

            if (fotoContainer && fotoImg) {
                if (fotoUrl && fotoUrl.trim() !== '') {
                    fotoImg.src = fotoUrl;
                    fotoContainer.classList.remove('d-none');
                } else {
                    fotoContainer.classList.add('d-none');
                }
            }

            const modalEl = document.getElementById('modalEditarEvento');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }

        function abrirModalExcluirEvento(id, titulo) {
            document.getElementById('deleteEventoId').value = id;
            document.getElementById('deleteEventoTitulo').innerText = `"${titulo}"`;
            const modalEl = document.getElementById('modalExcluirEvento');
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }

        // Compressor de imagens compartilhado
        async function otimizarFileInput(inputElement) {
            if (!inputElement) return;
            inputElement.addEventListener('change', async function (e) {
                let file = e.target.files[0];
                if (!file) return;

                const isHeic = file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif') || file.type === 'image/heic';
                if (isHeic && typeof heic2any !== 'undefined') {
                    try {
                        const blobResult = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.85 });
                        const singleBlob = Array.isArray(blobResult) ? blobResult[0] : blobResult;
                        file = new File([singleBlob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                        const dt = new DataTransfer();
                        dt.items.add(file);
                        inputElement.files = dt.files;
                    } catch (heicErr) {
                        console.warn('Conversão de HEIC no cliente ignorada:', heicErr);
                    }
                }

                if (!file.type.startsWith('image/')) return;

                if (file.size > 1024 * 1024) {
                    try {
                        const img = new Image();
                        img.src = URL.createObjectURL(file);
                        await img.decode();

                        const maxDim = 1600;
                        let width = img.width;
                        let height = img.height;

                        if (width > maxDim || height > maxDim) {
                            if (width > height) {
                                height = Math.round((height * maxDim) / width);
                                width = maxDim;
                            } else {
                                width = Math.round((width * maxDim) / height);
                                height = maxDim;
                            }
                        }

                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob(function (blob) {
                            if (blob && blob.size < file.size) {
                                const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                                const dt = new DataTransfer();
                                dt.items.add(newFile);
                                inputElement.files = dt.files;
                            }
                        }, 'image/jpeg', 0.85);
                    } catch (err) {
                        console.warn('Otimização ignorada:', err);
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            otimizarFileInput(document.querySelector('input[name="fotoEvento"]'));
            otimizarFileInput(document.getElementById('editEventoNovaFotoInput'));
        });
    </script>
}

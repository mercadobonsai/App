@model MercadoBonsai.Domain.Entities.Rifa
@{
    ViewData["Title"] = "Nova Ação entre Amigos - Mercado Bonsai";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="icon-base ri ri-ticket-line me-2 text-success"></i>Cadastrar Nova Ação Entre Amigos</h5>
                    <a asp-action="MinhasRifas" class="btn btn-sm btn-outline-secondary">Voltar</a>
                </div>
                <div class="card-body p-4">
                    <form id="formCriarRifa" asp-action="Criar" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold">Título da Ação entre Amigos *</label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ex: Ação Entre Amigos - Bonsai Pinus Parviflora 15 anos" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subtitulo" class="form-label fw-semibold">Exemplar da Ação / Subtítulo</label>
                            <input asp-for="Subtitulo" class="form-control" placeholder="Ex: Edição Especial de Primavera com Vaso Japonês" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="ValorCota" class="form-label fw-semibold">Valor por Cota (R$) *</label>
                                <input asp-for="ValorCota" class="form-control" type="number" step="0.01" value="25.00" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TotalCotas" class="form-label fw-semibold">Total de Cotas *</label>
                                <input asp-for="TotalCotas" class="form-control" type="number" value="100" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DataSorteio" class="form-label fw-semibold">Data da Apuração *</label>
                                <input asp-for="DataSorteio" type="date" class="form-control" value="@Model.DataSorteio.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label fw-semibold">Descrição do Exemplar da Ação</label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva os detalhes da planta ou insumo, regulamento e envio..."></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto Principal (Capa) *</label>
                                <input type="file" name="fotoPrincipal" id="fotoPrincipal" class="form-control" accept="image/*" required />
                                <small class="text-muted d-block mt-1">Otimizada automaticamente antes do envio.</small>
                                <div id="previewPrincipalContainer" class="mt-2 d-none">
                                    <img id="imgPreviewPrincipal" src="" class="img-fluid rounded border shadow-sm" style="max-height: 160px; width: 100%; object-fit: cover;" alt="Prévia da Foto Principal" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Foto de Detalhe</label>
                                <input type="file" name="fotoDetalhe" id="fotoDetalhe" class="form-control" accept="image/*" />
                                <small class="text-muted d-block mt-1">Opcional para mostrar detalhes da planta.</small>
                                <div id="previewDetalheContainer" class="mt-2 d-none">
                                    <img id="imgPreviewDetalhe" src="" class="img-fluid rounded border shadow-sm" style="max-height: 160px; width: 100%; object-fit: cover;" alt="Prévia da Foto de Detalhe" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="MinhasRifas" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" id="btnSubmitRifa" class="btn btn-success px-4">
                                <i class="icon-base ri ri-save-line me-1"></i> Publicar Ação entre Amigos
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"></script>
    <script>
        async function otimizarInputImagem(fileInput, imgPreview, previewContainer) {
            if (!fileInput) return;

            fileInput.addEventListener('change', async function (e) {
                let file = e.target.files[0];
                if (!file) {
                    if (previewContainer) previewContainer.classList.add('d-none');
                    return;
                }

                const isHeic = file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif') || file.type === 'image/heic';
                if (isHeic && typeof heic2any !== 'undefined') {
                    try {
                        const blobResult = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.85 });
                        const singleBlob = Array.isArray(blobResult) ? blobResult[0] : blobResult;
                        file = new File([singleBlob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                        const dt = new DataTransfer();
                        dt.items.add(file);
                        fileInput.files = dt.files;
                    } catch (heicErr) {
                        console.warn('Conversão de HEIC no cliente ignorada:', heicErr);
                    }
                }

                if (!file.type.startsWith('image/')) return;

                if (imgPreview && previewContainer) {
                    imgPreview.src = URL.createObjectURL(file);
                    previewContainer.classList.remove('d-none');
                }

                if (file.size > 800 * 1024) {
                    try {
                        const img = new Image();
                        img.src = URL.createObjectURL(file);
                        await img.decode();

                        const maxDim = 1600;
                        let width = img.width;
                        let height = img.height;

                        if (width > maxDim || height > maxDim) {
                            if (width > height) {
                                height = Math.round((height * maxDim) / width);
                                width = maxDim;
                            } else {
                                width = Math.round((width * maxDim) / height);
                                height = maxDim;
                            }
                        }

                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob(function (blob) {
                            if (blob && blob.size < file.size) {
                                const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), { type: 'image/jpeg' });
                                const dt = new DataTransfer();
                                dt.items.add(newFile);
                                fileInput.files = dt.files;
                                if (imgPreview) imgPreview.src = URL.createObjectURL(newFile);
                            }
                        }, 'image/jpeg', 0.85);
                    } catch (err) {
                        console.warn('Otimização de imagem no navegador ignorada:', err);
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            otimizarInputImagem(
                document.getElementById('fotoPrincipal'),
                document.getElementById('imgPreviewPrincipal'),
                document.getElementById('previewPrincipalContainer')
            );

            otimizarInputImagem(
                document.getElementById('fotoDetalhe'),
                document.getElementById('imgPreviewDetalhe'),
                document.getElementById('previewDetalheContainer')
            );

            const form = document.getElementById('formCriarRifa');
            const btn = document.getElementById('btnSubmitRifa');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Publicando ação...';
                });
            }
        });
    </script>
}

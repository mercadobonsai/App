<!doctype html>
<html lang="pt-BR"
      class="layout-navbar-fixed layout-menu-fixed layout-compact"
      dir="ltr"
      data-skin="default"
      data-assets-path="~/starter-kit/assets/"
      data-template="horizontal-menu-template-no-customizer-starter"
      data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] - Mercado Bonsai</title>

    <link rel="icon" type="image/png" href="~/starter-kit/assets/img/favicon/favicon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/starter-kit/assets/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/css/demo.css" />
    <link rel="stylesheet" href="~/starter-kit/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <!-- Page CSS -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- Helpers -->
    <script src="~/starter-kit/assets/vendor/js/helpers.js"></script>
    <script src="~/starter-kit/assets/js/config.js"></script>
</head>
<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-navbar-full layout-horizontal layout-without-menu">
        <div class="layout-container">

            <!-- Navbar -->
            <nav class="layout-navbar navbar navbar-expand-xl align-items-center" id="layout-navbar">
                <div class="container-xxl">
                    <!-- Brand Logo Padrao Revertido -->
                    <div class="navbar-brand app-brand demo d-none d-xl-flex py-0 me-6">
                        <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2 align-items-center">
                            <img src="~/starter-kit/assets/img/logo.png" alt="Mercado Bonsai Logo" style="height: 38px; width: auto; border-radius: 6px;" />
                            <span class="app-brand-text demo menu-text fw-bold ms-1" style="color: #4A7C59;">Mercado Bonsai</span>
                        </a>
                        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-xl-none">
                            <i class="icon-base ri ri-close-line icon-sm"></i>
                        </a>
                    </div>

                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base ri ri-menu-line icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <!-- Dropdown do Perfil de Usuário -->
                                <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                    <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
                                        <div class="avatar avatar-online">
                                            <span class="avatar-initial rounded-circle bg-success text-white">
                                                @User.Identity.Name?.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Conta" asp-action="MeuPerfil">
                                                <div class="d-flex">
                                                    <div class="flex-shrink-0 me-3">
                                                        <div class="avatar avatar-online">
                                                            <span class="avatar-initial rounded-circle bg-success text-white">
                                                                @User.Identity.Name?.Substring(0, 1).ToUpper()
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@User.Identity.Name</h6>
                                                        <small class="text-body-secondary">
                                                            @if (User.IsInRole("Administrador")) { <span class="badge bg-danger">Administrador</span> }
                                                            else if (User.IsInRole("Vendedor")) { <span class="badge bg-warning text-dark">Vendedor</span> }
                                                            else { <span class="badge bg-info">Comprador</span> }
                                                        </small>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li><div class="dropdown-divider my-1"></div></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Conta" asp-action="MeuPerfil">
                                                <i class="icon-base ri ri-user-line icon-md me-3"></i>
                                                <span>Meu Perfil</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Conta" asp-action="Assinatura">
                                                <i class="icon-base ri ri-vip-crown-line icon-md me-3"></i>
                                                <span>Minha Assinatura / Planos</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Propaganda" asp-action="MinhasPropagandas">
                                                <i class="icon-base ri ri-advertisement-line icon-md me-3"></i>
                                                <span>Minhas Propagandas</span>
                                            </a>
                                        </li>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Admin" asp-action="Clientes">
                                                    <i class="icon-base ri ri-shield-keyhole-line icon-md me-3"></i>
                                                    <span>Painel Admin</span>
                                                </a>
                                            </li>
                                        }
                                        <li><div class="dropdown-divider my-1"></div></li>
                                        <li>
                                            <div class="d-grid px-4 pt-2 pb-1">
                                                <a asp-controller="Conta" asp-action="Logout" class="btn btn-danger d-flex">
                                                    <small class="align-middle">Sair</small>
                                                    <i class="ri ri-logout-box-r-line ms-2 ri-xs"></i>
                                                </a>
                                            </div>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a asp-controller="Conta" asp-action="Cadastro" class="btn btn-outline-success btn-sm">
                                        Cadastrar
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Conta" asp-action="Login" class="btn btn-success btn-sm">
                                        <i class="ri ri-login-box-line me-1"></i>Entrar
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>
                </div>
            </nav>
            <!-- / Navbar -->

            <!-- Layout container -->
            <div class="layout-page">
                <!-- Content wrapper -->
                <div class="content-wrapper">

                    <!-- Menu principal de navegação -->
                    <aside id="layout-menu" class="layout-menu-horizontal menu-horizontal menu flex-grow-0">
                        <div class="container-xxl d-flex h-100">
                            <ul class="menu-inner py-1">
                                <!-- Link Início -->
                                <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                    <a asp-controller="Home" asp-action="Index" class="menu-link">
                                        <i class="menu-icon icon-base ri ri-home-smile-line"></i>
                                        <div>Início</div>
                                    </a>
                                </li>

                                <!-- Link Vitrine (Bonsais) -->
                                <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Produto" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                    <a asp-controller="Produto" asp-action="Index" class="menu-link">
                                        <i class="menu-icon icon-base ri ri-store-2-line"></i>
                                        <div>Vitrine</div>
                                    </a>
                                </li>

                                <!-- Link Insumos & Ferramentas -->
                                <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Insumo" ? "active" : "")">
                                    <a asp-controller="Insumo" asp-action="Index" class="menu-link">
                                        <i class="menu-icon icon-base ri ri-tools-line"></i>
                                        <div>Insumos & Ferramentas</div>
                                    </a>
                                </li>

                                <!-- Link Vasos & Cerâmicas -->
                                <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vaso" ? "active" : "")">
                                    <a asp-controller="Vaso" asp-action="Index" class="menu-link">
                                        <i class="menu-icon icon-base ri ri-cup-line"></i>
                                        <div>Vasos & Cerâmicas</div>
                                    </a>
                                </li>

                                <!-- Link Leilões & Ações (Simplificado) -->
                                <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leilao" && ViewContext.RouteData.Values["action"]?.ToString() == "Encerrados" ? "active" : "")">
                                    <a asp-controller="Leilao" asp-action="Encerrados" class="menu-link">
                                        <i class="menu-icon icon-base ri ri-auction-line"></i>
                                        <div>Leilões & Ações</div>
                                    </a>
                                </li>

                                <!-- Dropdown Cadastros (Visível para Vendedor e Admin) -->
                                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Vendedor") || User.IsInRole("Administrador")))
                                {
                                    <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Produto" && (ViewContext.RouteData.Values["action"]?.ToString() == "MeusProdutos" || ViewContext.RouteData.Values["action"]?.ToString() == "Criar") || ViewContext.RouteData.Values["controller"]?.ToString() == "Leilao" && ViewContext.RouteData.Values["action"]?.ToString() == "MeusLeiloes" || ViewContext.RouteData.Values["controller"]?.ToString() == "Rifa" || ViewContext.RouteData.Values["controller"]?.ToString() == "Propaganda" ? "active" : "")">
                                        <a href="javascript:void(0)" class="menu-link menu-toggle">
                                            <i class="menu-icon icon-base ri ri-folder-add-line"></i>
                                            <div>Cadastros</div>
                                        </a>
                                        <ul class="menu-sub">
                                            <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MeusProdutos" ? "active" : "")">
                                                <a asp-controller="Produto" asp-action="MeusProdutos" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-store-line me-2"></i>
                                                    <div>Meus Produtos</div>
                                                </a>
                                            </li>
                                            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leilao" && ViewContext.RouteData.Values["action"]?.ToString() == "MeusLeiloes" ? "active" : "")">
                                                <a asp-controller="Leilao" asp-action="MeusLeiloes" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-auction-line me-2"></i>
                                                    <div>Meus Leilões</div>
                                                </a>
                                            </li>
                                            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rifa" ? "active" : "")">
                                                <a asp-controller="Rifa" asp-action="MinhasRifas" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-ticket-line me-2"></i>
                                                    <div>Minhas Ações</div>
                                                </a>
                                            </li>
                                            <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Propaganda" ? "active" : "")">
                                                <a asp-controller="Propaganda" asp-action="MinhasPropagandas" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-advertisement-line me-2"></i>
                                                    <div>Minhas Propagandas</div>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                }

                                <!-- Dropdown Administrador (Restrito exclusivamente a perfil Administrador) -->
                                @if (User.IsInRole("Administrador"))
                                {
                                    <li class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                                        <a href="javascript:void(0)" class="menu-link menu-toggle">
                                            <i class="menu-icon icon-base ri ri-shield-keyhole-line"></i>
                                            <div>Administrador</div>
                                        </a>
                                        <ul class="menu-sub">
                                            <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Clientes" ? "active" : "")">
                                                <a asp-controller="Admin" asp-action="Clientes" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-user-settings-line me-2"></i>
                                                    <div>Clientes (Vendedores)</div>
                                                </a>
                                            </li>
                                            <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Planos" ? "active" : "")">
                                                <a asp-controller="Admin" asp-action="Planos" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-vip-crown-line me-2"></i>
                                                    <div>Gestão de Planos</div>
                                                </a>
                                            </li>
                                            <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Propagandas" ? "active" : "")">
                                                <a asp-controller="Admin" asp-action="Propagandas" class="menu-link">
                                                    <i class="menu-icon icon-base ri ri-advertisement-line me-2"></i>
                                                    <div>Gestão de Propagandas</div>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    </aside>
                    <!-- / Menu -->

                    <!-- Content -->
                    <div class="container-xxl flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>
                    <!-- / Content -->

                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl">
                            <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                                <div class="mb-2 mb-md-0">
                                    &copy; <script>document.write(new Date().getFullYear());</script> <span style="color: #4A7C59; font-weight: 600;">Mercado Bonsai</span> — Todos os direitos reservados.
                                </div>
                                <div class="d-none d-lg-inline-block">
                                    <a asp-controller="Home" asp-action="Privacy" class="footer-link me-4">Privacidade</a>
                                    <a href="mailto:contato@mercadobonsai.com.br" class="footer-link">Contato</a>
                                </div>
                            </div>
                        </div>
                    </footer>
                    <!-- / Footer -->

                    <div class="content-backdrop fade"></div>
                </div>
                <!-- / Content wrapper -->
            </div>
            <!-- / Layout container -->
        </div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Overlay -->
    <div class="layout-overlay layout-menu-toggle"></div>
    <div class="drag-target"></div>

    <!-- Core JS -->
    <script src="~/starter-kit/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/starter-kit/assets/vendor/js/bootstrap.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/node-waves/node-waves.css"></script>
    <script src="~/starter-kit/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/starter-kit/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/starter-kit/assets/vendor/js/menu.js"></script>
    <script src="~/starter-kit/assets/js/main.js"></script>
    <script src="~/starter-kit/assets/js/masks.js"></script>

    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Script Global de Spinner de Carregamento para Botões de Submit -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const forms = document.querySelectorAll("form");
            forms.forEach(function (form) {
                form.addEventListener("submit", function () {
                    const submitBtns = form.querySelectorAll("button[type='submit'], input[type='submit']");
                    submitBtns.forEach(function (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processando...';
                    });
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
